VertexLitGeneric
{
	$basetexture "models/sponza/lion"
	$bumpmap "models/sponza/lion_ddn"

	$phong 1
	$envmap "env_cubemap"
	"$envmaptint" "[0.01 0.01 0.002]"
	"$normalmapalphaenvmapmask" "1"
	

	"$phongboost" "0.3"
    	"$phongalbedotint" "1"
    	"$phongalbedoboost" "1"
    	"$phongfresnelranges" "[1 0.1 0]"

    	"$rimlight" "1"
    	"$rimlightexponent" "100"
    	"$rimmask" "1"
    	"$rimlightboost" "1.5"


}