// DYNAMIC: "PIXELFOGTYPE" "0..1"

#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"

sampler sDepth    : register( s0 );
sampler sAlbedo   : register( s1 );
sampler sLighting : register( s2 );

const float3 g_vecViewOrigin : register( c0 );
const float4 g_vecFogParams  : register( c1 );

struct PS_INPUT
{
	float2 vTexCoord   : TEXCOORD0;
	float3 vecWorldRay : TEXCOORD1;
};

struct PS_OUTPUT
{
	float4 vColor_0 : COLOR0;
};

PS_OUTPUT main( const PS_INPUT In )
{
	PS_OUTPUT Out;
	float depth = min( DEPTH_RECONSTRUCTION_LIMIT, tex2D( sDepth, In.vTexCoord ).x );
	float4 albedo = tex2D( sAlbedo, In.vTexCoord );
	float4 lighting = tex2D( sLighting, In.vTexCoord );
	float3 specularLighting = 0.0f;
	float skyAmount = step( depth, 0.001f );
	float3 worldPosition = g_vecViewOrigin + In.vecWorldRay * depth;

	// Radiance Hints is reconstructed additively into LightAccum before this pass.
	lighting = lerp( lighting, float4( 1, 1, 1, 0 ), skyAmount );

	float lightScale =
#if DEFCFG_USE_SRGB_CONVERSION
		LINEAR_LIGHT_SCALE;
#else
		GAMMA_LIGHT_SCALE;
#endif

	Out.vColor_0.w = 0.0f;
	Out.vColor_0.xyz = ( ( albedo.rgb + lighting.w ) * lighting.xyz + specularLighting ) * lightScale;

#if PIXELFOGTYPE == 0
	float fogAmount = CalcPixelFogFactor( PIXELFOGTYPE, g_vecFogParams, g_vecViewOrigin, worldPosition, 0 );
	fogAmount = lerp( fogAmount, 0.0f, skyAmount );
	Out.vColor_0.xyz = lerp( Out.vColor_0.xyz, g_LinearFogColor, fogAmount );
#endif
	return Out;
}
