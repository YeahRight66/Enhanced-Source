// STATIC: "FILTER_PHASE" "0..2"
// 0 = X axis, 1 = Y axis, 2 = Z axis.

#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"
#include "radiance_hints_common_fxc.h"

sampler sSH_R       : register( s0 );
sampler sSH_G       : register( s1 );
sampler sSH_B       : register( s2 );
sampler sMeta       : register( s3 );
sampler sBlockerField : register( s4 );

// x filter strength, y confidence fill boost, z log-energy similarity,
// w reliable-cell anchor strength.
const float4 g_RHFilter : register( c0 );
// x blocker strength, y blocker bias, z minimum transmittance,
// w neighbour radius in cells.
const float4 g_RHBlocker : register( c1 );
// x maximum radiance.
const float4 g_RHQuality : register( c2 );
// xyz = radiance boundary UV to independently snapped blocker boundary UV.
const float3 g_RHBlockerUVWOffset : register( c3 );

struct PS_INPUT
{
    float3 vVolumeUVW : TEXCOORD0;
    float2 vAtlasUV   : TEXCOORD1;
};

struct PS_OUTPUT
{
    float4 vSH_R : COLOR0;
    float4 vSH_G : COLOR1;
    float4 vSH_B : COLOR2;
    float4 vMeta : COLOR3;
};

#define RH_FILTER_SAMPLE( DX, DY, DZ ) \
{ \
    float3 rhDirection = float3( DX, DY, DZ ); \
    float3 rhSampleUVW = In.vVolumeUVW + rhDirection * ( g_RHBlocker.w / RH_VOLUME_SIZE_F ); \
    float rhInside = RH_InsideVolume( rhSampleUVW ); \
    float4 rhMeta = RH_SampleAtlas( sMeta, rhSampleUVW ); \
    float rhConfidence = RH_MetaConfidence( rhMeta ); \
    float rhValid = step( 1.0e-5f, rhMeta.z ); \
    float rhEnergySimilarity = RH_EnergySimilarity( centerMeta.z, rhMeta.z, g_RHFilter.z ); \
    rhEnergySimilarity = lerp( 1.0f, rhEnergySimilarity, centerConfidence ); \
    float3 rhMidUVW = In.vVolumeUVW + rhDirection * ( 0.5f * g_RHBlocker.w / RH_VOLUME_SIZE_F ); \
    float4 rhField = RH_SampleShadowAtlas( sBlockerField, rhMidUVW + g_RHBlockerUVWOffset ); \
    float rhDistanceBlocker = saturate( 1.0f - RH_BlockerDistanceCells( rhField ) / 0.55f ); \
    float rhBlocker = RH_BlockerOpacity( rhField ) * rhDistanceBlocker; \
    float rhBias = clamp( g_RHBlocker.y, 0.0f, 0.95f ); \
    rhBlocker = saturate( ( rhBlocker - rhBias ) / max( 1.0f - rhBias, 0.05f ) ); \
    float rhTransmittance = max( exp2( -4.0f * max( g_RHBlocker.x, 0.0f ) * rhBlocker ), saturate( g_RHBlocker.z ) ); \
    float rhFillBoost = lerp( 1.0f, max( g_RHFilter.y, 1.0f ), 1.0f - centerConfidence ); \
    float rhWeight = rhInside * rhValid * max( rhConfidence, 0.035f ) * rhEnergySimilarity \
        * rhTransmittance * saturate( g_RHFilter.x ) * rhFillBoost; \
    sumR += RH_LimitRadianceSH( RH_SampleAtlas( sSH_R, rhSampleUVW ) ) * rhWeight; \
    sumG += RH_LimitRadianceSH( RH_SampleAtlas( sSH_G, rhSampleUVW ) ) * rhWeight; \
    sumB += RH_LimitRadianceSH( RH_SampleAtlas( sSH_B, rhSampleUVW ) ) * rhWeight; \
    confidenceSum += rhConfidence * rhWeight; \
    distanceSum += rhMeta.y * rhWeight; \
    energySum += rhMeta.z * rhWeight; \
    visibilitySum += rhMeta.w * rhWeight; \
    weightSum += rhWeight; \
}

PS_OUTPUT main( const PS_INPUT In )
{
    PS_OUTPUT Out;

    // The center is exactly on an atlas texel generated by the volume mesh, so
    // direct tex2Dlod avoids two-slice interpolation and keeps this permutation
    // below the old ps_3_0 compiler's texture/instruction pressure threshold.
    float4 centerMeta = tex2Dlod( sMeta, float4( In.vAtlasUV, 0.0f, 0.0f ) );
    float centerConfidence = RH_MetaConfidence( centerMeta );
    float centerValid = step( 1.0e-5f, centerMeta.z );
    float centerAnchor = lerp( 1.0f, 2.25f, saturate( g_RHFilter.w ) * centerConfidence );
    float centerWeight = lerp( 0.12f, 1.0f + centerConfidence * centerAnchor, centerValid );

    float4 sumR = RH_LimitRadianceSH( tex2Dlod( sSH_R, float4( In.vAtlasUV, 0.0f, 0.0f ) ) ) * centerWeight;
    float4 sumG = RH_LimitRadianceSH( tex2Dlod( sSH_G, float4( In.vAtlasUV, 0.0f, 0.0f ) ) ) * centerWeight;
    float4 sumB = RH_LimitRadianceSH( tex2Dlod( sSH_B, float4( In.vAtlasUV, 0.0f, 0.0f ) ) ) * centerWeight;
    float confidenceSum = centerConfidence * centerWeight;
    float distanceSum = centerMeta.y * centerWeight;
    float energySum = centerMeta.z * centerWeight;
    float visibilitySum = centerMeta.w * centerWeight;
    float weightSum = centerWeight;

#if FILTER_PHASE == 0
    RH_FILTER_SAMPLE( 1.0f, 0.0f, 0.0f );
    RH_FILTER_SAMPLE(-1.0f, 0.0f, 0.0f );
#elif FILTER_PHASE == 1
    RH_FILTER_SAMPLE( 0.0f, 1.0f, 0.0f );
    RH_FILTER_SAMPLE( 0.0f,-1.0f, 0.0f );
#else
    RH_FILTER_SAMPLE( 0.0f, 0.0f, 1.0f );
    RH_FILTER_SAMPLE( 0.0f, 0.0f,-1.0f );
#endif

    float inverseWeight = 1.0f / max( weightSum, 1.0e-5f );
    float coefficientClamp = max( g_RHQuality.x, 0.25f );
    Out.vSH_R = clamp( RH_LimitRadianceSH( sumR * inverseWeight ), -coefficientClamp, coefficientClamp );
    Out.vSH_G = clamp( RH_LimitRadianceSH( sumG * inverseWeight ), -coefficientClamp, coefficientClamp );
    Out.vSH_B = clamp( RH_LimitRadianceSH( sumB * inverseWeight ), -coefficientClamp, coefficientClamp );

    float confidence = saturate( confidenceSum * inverseWeight );
    float outputEnergy = saturate(
        RH_RadianceEnergy( Out.vSH_R, Out.vSH_G, Out.vSH_B )
        / max( g_RHQuality.x, 0.25f ) );
    Out.vMeta = float4(
        confidence,
        saturate( distanceSum * inverseWeight ),
        max( outputEnergy, saturate( energySum * inverseWeight ) * 0.20f ),
        saturate( visibilitySum * inverseWeight ) );
    return Out;
}
