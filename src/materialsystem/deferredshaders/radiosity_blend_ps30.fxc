// STATIC: "PASS_MODE" "0..0"
// DYNAMIC: "SECOND_BOUNCE" "0..1"
// DYNAMIC: "PROBE_INDEX" "0..3"
// DYNAMIC: "DEBUG_MODE" "0..10"
// SKIP: ( $DEBUG_MODE != 0 ) && ( $DEBUG_MODE != 2 ) && $SECOND_BOUNCE
// Half-resolution, visibility-aware tetrahedral daylight-GI receiver.

#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"
#include "radiance_hints_common_fxc.h"

sampler sDepth        : register( s0 );
sampler sNormals      : register( s1 );
sampler sFirstR       : register( s2 );
sampler sFirstG       : register( s3 );
sampler sFirstB       : register( s4 );
sampler sSecondR      : register( s5 );
sampler sSecondG      : register( s6 );
sampler sSecondB      : register( s7 );
sampler sMeta         : register( s8 );
sampler sBlockerField : register( s9 );
sampler sSurfaceCache : register( s10 );

const float3 g_vecViewOrigin : register( c0 );
const float3 g_vecRHOrigin   : register( c1 );
// x volume extent, y receiver offset world, z final intensity, w second-bounce scale.
const float4 g_RHSettings    : register( c2 );
// x saturation, y max radiance, z reserved, w confidence floor.
const float4 g_RHQuality     : register( c3 );
// x visibility strength, y reserved, z reserved, w minimum visibility.
const float4 g_RHShadow      : register( c4 );
// x visibility enable, y blocker bias, z reserved, w reserved.
const float4 g_RHSDFControl  : register( c7 );
// xyz = radiance boundary UV to independently snapped blocker boundary UV.
const float3 g_RHShadowUVWOffset : register( c9 );
// x receiver visibility weight, y relocation clearance in radiance cells,
// z debug mode, w maximum relocation in radiance cells.
const float4 g_RHReceiver : register( c10 );
// xyz = near-clip origin, w = near extent.
const float4 g_GINearClip : register( c11 );
// x = active clip, y = near blend width cells, z = far fade width cells,
// w = radiance volume size.
const float4 g_GIClipBlend : register( c12 );

struct PS_INPUT
{
    float2 vTexCoord   : TEXCOORD0;
    float3 vecWorldRay : TEXCOORD1;
};

float3 RH_GeometricNormal( float3 worldPos, float3 shadingNormal )
{
    float3 worldDX = ddx( worldPos );
    float3 worldDY = ddy( worldPos );
    float3 geometric = RH_SafeNormalize( cross( worldDX, worldDY ), shadingNormal );
    return dot( geometric, shadingNormal ) >= 0.0f ? geometric : -geometric;
}

float GI_EdgeCells( float3 uvw, float volumeSize )
{
    float nearestEdge = min( min( min( uvw.x, uvw.y ), uvw.z ),
        min( min( 1.0f - uvw.x, 1.0f - uvw.y ), 1.0f - uvw.z ) );
    return max( nearestEdge * volumeSize, 0.0f );
}

float GI_ClipWeight( float3 worldPos, float3 activeUVW )
{
    float activeInside = RH_InsideVolume( activeUVW );
    if ( g_GIClipBlend.x < 0.5f )
        return activeInside * saturate( GI_EdgeCells( activeUVW, RH_VOLUME_SIZE_F ) /
            max( g_GIClipBlend.y, 1.0f ) );

    float3 nearUVW = ( worldPos - g_GINearClip.xyz ) / max( g_GINearClip.w, 1.0f );
    float nearWeight = RH_InsideVolume( nearUVW ) *
        saturate( GI_EdgeCells( nearUVW, g_GIClipBlend.w ) / max( g_GIClipBlend.y, 1.0f ) );
    float farOuterFade = saturate( GI_EdgeCells( activeUVW, RH_VOLUME_SIZE_F ) /
        max( g_GIClipBlend.z, 1.0f ) );
    return activeInside * farOuterFade * ( 1.0f - nearWeight );
}

float GI_ProbeVisibilitySample( float3 traceUVW )
{
    float4 field = RH_SampleShadowAtlas( sBlockerField, traceUVW );
    float proximity = saturate( 1.0f - RH_BlockerDistanceCells( field ) / 0.55f );
    float opacity = RH_BlockerOpacity( field );
    float bias = saturate( g_RHSDFControl.y );
    float hit = saturate( ( opacity * proximity - bias ) / max( 1.0f - bias, 0.05f ) );
    return lerp( 1.0f, max( 1.0f - hit, saturate( g_RHShadow.w ) ),
        RH_InsideVolume( traceUVW ) );
}

float GI_ProbeVisibility( float3 receiverBlockerUVW, float3 probeBlockerUVW )
{
    float3 segmentCells = ( probeBlockerUVW - receiverBlockerUVW ) * RH_SHADOW_VOLUME_SIZE_F;
    float segmentLength = length( segmentCells );
    if ( segmentLength < 0.20f )
        return 1.0f;

    float visibility = GI_ProbeVisibilitySample(
        lerp( receiverBlockerUVW, probeBlockerUVW, 0.25f ) );
    visibility *= GI_ProbeVisibilitySample(
        lerp( receiverBlockerUVW, probeBlockerUVW, 0.50f ) );
    visibility *= GI_ProbeVisibilitySample(
        lerp( receiverBlockerUVW, probeBlockerUVW, 0.75f ) );

    float visibilityStrength = saturate( g_RHSDFControl.x ) *
        saturate( g_RHShadow.x ) * saturate( g_RHReceiver.x );
    return lerp( 1.0f, visibility, visibilityStrength );
}

// Keep the complete probe gather in one helper instead of expanding a large
// preprocessor macro four times. The legacy d3dx9_33 compiler used by Source's
// shadercompile wrapper can otherwise fail internally before reporting a useful
// diagnostic, even though newer standalone FXC versions accept the shader.
void GI_AccumulateProbe(
    float3 probeCell,
    float baryWeight,
    float4 diffuseBasis,
    float3 worldPos,
    float3 geometricNormal,
    float3 receiverBlockerUVW,
    float radianceCell,
    inout float3 firstSum,
    inout float3 secondSum,
    inout float weightSum,
    inout float confidenceSum,
    inout float injectionVisibilitySum,
    inout float rejectionSum,
    inout float3 shDirectionSum,
    inout float shDCSum )
{
    float3 nominalProbeUVW = ( probeCell + 0.5f ) / RH_VOLUME_SIZE_F;
    float4 probeField = RH_SampleShadowAtlas( sBlockerField, nominalProbeUVW + g_RHShadowUVWOffset );
    float blockerDistanceRadianceCells = RH_BlockerDistanceCells( probeField ) *
        ( RH_VOLUME_SIZE_F / RH_SHADOW_VOLUME_SIZE_F );
    float relocationCells = min( clamp( g_RHReceiver.w, 0.0f, 0.45f ),
        max( g_RHReceiver.y - blockerDistanceRadianceCells, 0.0f ) );
    float3 relocatedProbeUVW = nominalProbeUVW + RH_DecodeBlockerNormal( probeField.ba ) *
        ( relocationCells / RH_VOLUME_SIZE_F );
    float3 probeWorld = g_vecRHOrigin + relocatedProbeUVW * g_RHSettings.x;
    float3 receiverToProbe = probeWorld - worldPos;
    float frontFacing = smoothstep( -0.35f * radianceCell, 0.15f * radianceCell,
        dot( receiverToProbe, geometricNormal ) );
    float probeVisibility = GI_ProbeVisibility( receiverBlockerUVW,
        relocatedProbeUVW + g_RHShadowUVWOffset );
    float4 probeMeta = RH_SampleAtlasCell( sMeta, probeCell );
    float probeValid = step( 1.0e-5f, probeMeta.z );
    float probeConfidence = probeValid * max( RH_MetaConfidence( probeMeta ), saturate( g_RHQuality.w ) );
    float positiveBaryWeight = max( baryWeight, 0.0f );
    float interpolationWeight = positiveBaryWeight * probeConfidence;
    float probeWeight = interpolationWeight * probeVisibility * frontFacing;
    float4 firstR = RH_LimitRadianceSH( RH_SampleAtlasCell( sFirstR, probeCell ) );
    float4 firstG = RH_LimitRadianceSH( RH_SampleAtlasCell( sFirstG, probeCell ) );
    float4 firstB = RH_LimitRadianceSH( RH_SampleAtlasCell( sFirstB, probeCell ) );
    firstSum += max( float3( dot( firstR, diffuseBasis ), dot( firstG, diffuseBasis ),
        dot( firstB, diffuseBasis ) ), 0.0f ) * probeWeight;
    shDirectionSum += ( firstR.xyz * 0.2126f + firstG.xyz * 0.7152f + firstB.xyz * 0.0722f ) * probeWeight;
    shDCSum += max( firstR.w * 0.2126f + firstG.w * 0.7152f + firstB.w * 0.0722f, 0.0f ) * probeWeight;
#if SECOND_BOUNCE
    float4 secondR = RH_LimitRadianceSH( RH_SampleAtlasCell( sSecondR, probeCell ) );
    float4 secondG = RH_LimitRadianceSH( RH_SampleAtlasCell( sSecondG, probeCell ) );
    float4 secondB = RH_LimitRadianceSH( RH_SampleAtlasCell( sSecondB, probeCell ) );
    secondSum += max( float3( dot( secondR, diffuseBasis ), dot( secondG, diffuseBasis ),
        dot( secondB, diffuseBasis ) ), 0.0f ) * probeWeight;
#endif
    // Visibility attenuates radiance but is deliberately excluded from the
    // interpolation denominator. Renormalising by visibility would cancel an
    // indirect shadow whenever all four probes saw similar occlusion.
    weightSum += interpolationWeight;
    confidenceSum += positiveBaryWeight * probeConfidence;
    injectionVisibilitySum += positiveBaryWeight * saturate( probeMeta.w );
    rejectionSum += positiveBaryWeight * ( 1.0f - probeVisibility * frontFacing );
}

float4 main( const PS_INPUT In ) : COLOR0
{
    float depth = tex2D( sDepth, In.vTexCoord ).x;
    clip( min( depth - 0.1f, DEPTH_RECONSTRUCTION_LIMIT - depth ) );
    float3 worldPos = g_vecViewOrigin + In.vecWorldRay * depth;
    float3 shadingNormal = RH_SafeNormalize(
        DecodeDirectionVectorXYZFromSphericalST( tex2D( sNormals, In.vTexCoord ).xy ),
        float3( 0.0f, 0.0f, 1.0f ) );
    float3 geometricNormal = RH_GeometricNormal( worldPos, shadingNormal );
    float inverseExtent = 1.0f / max( g_RHSettings.x, 1.0f );
    float3 receiverWorld = worldPos + geometricNormal * g_RHSettings.y;
    float3 uvw = ( receiverWorld - g_vecRHOrigin ) * inverseExtent;
    float volumeMask = GI_ClipWeight( worldPos, uvw );
    if ( volumeMask <= 1.0e-5f )
        return 0.0f;

    float3 gridPosition = clamp( uvw * RH_VOLUME_SIZE_F - 0.5f,
        0.0f, RH_VOLUME_SIZE_F - 1.0001f );
    float3 baseCell = min( floor( gridPosition ), RH_VOLUME_SIZE_F - 2.0f );
    float3 fraction = saturate( gridPosition - baseCell );

    float3 cell0 = baseCell;
    float3 cell1;
    float3 cell2;
    float3 cell3 = baseCell + 1.0f;
    float4 barycentric;

    // Six tetrahedra partition the voxel cube without introducing the diagonal
    // over-blur of trilinear eight-probe reconstruction.
    if ( fraction.x >= fraction.y )
    {
        if ( fraction.y >= fraction.z )
        {
            cell1 = baseCell + float3( 1.0f, 0.0f, 0.0f );
            cell2 = baseCell + float3( 1.0f, 1.0f, 0.0f );
            barycentric = float4( 1.0f - fraction.x, fraction.x - fraction.y,
                fraction.y - fraction.z, fraction.z );
        }
        else if ( fraction.x >= fraction.z )
        {
            cell1 = baseCell + float3( 1.0f, 0.0f, 0.0f );
            cell2 = baseCell + float3( 1.0f, 0.0f, 1.0f );
            barycentric = float4( 1.0f - fraction.x, fraction.x - fraction.z,
                fraction.z - fraction.y, fraction.y );
        }
        else
        {
            cell1 = baseCell + float3( 0.0f, 0.0f, 1.0f );
            cell2 = baseCell + float3( 1.0f, 0.0f, 1.0f );
            barycentric = float4( 1.0f - fraction.z, fraction.z - fraction.x,
                fraction.x - fraction.y, fraction.y );
        }
    }
    else
    {
        if ( fraction.x >= fraction.z )
        {
            cell1 = baseCell + float3( 0.0f, 1.0f, 0.0f );
            cell2 = baseCell + float3( 1.0f, 1.0f, 0.0f );
            barycentric = float4( 1.0f - fraction.y, fraction.y - fraction.x,
                fraction.x - fraction.z, fraction.z );
        }
        else if ( fraction.y >= fraction.z )
        {
            cell1 = baseCell + float3( 0.0f, 1.0f, 0.0f );
            cell2 = baseCell + float3( 0.0f, 1.0f, 1.0f );
            barycentric = float4( 1.0f - fraction.y, fraction.y - fraction.z,
                fraction.z - fraction.x, fraction.x );
        }
        else
        {
            cell1 = baseCell + float3( 0.0f, 0.0f, 1.0f );
            cell2 = baseCell + float3( 0.0f, 1.0f, 1.0f );
            barycentric = float4( 1.0f - fraction.z, fraction.z - fraction.y,
                fraction.y - fraction.x, fraction.x );
        }
    }

    float radianceCell = g_RHSettings.x / RH_VOLUME_SIZE_F;
    float3 receiverBlockerUVW = uvw + g_RHShadowUVWOffset;
    float4 diffuseBasis = RH_DiffuseBasis( -shadingNormal );
    float3 firstSum = 0.0f;
    float3 secondSum = 0.0f;
    float weightSum = 0.0f;
    float confidenceSum = 0.0f;
    float injectionVisibilitySum = 0.0f;
    float rejectionSum = 0.0f;
    float3 shDirectionSum = 0.0f;
    float shDCSum = 0.0f;

    // Source's d3dx9_33 compiler cannot reliably compile the four fully
    // expanded gathers as one ps_3_0 program. Each dynamic permutation handles
    // one tetrahedral corner and the render loop combines the four numerators
    // and confidence denominators additively in the half-resolution target.
    float3 probeCell;
    float probeBaryWeight;
#if PROBE_INDEX == 0
    probeCell = cell0; probeBaryWeight = barycentric.x;
#elif PROBE_INDEX == 1
    probeCell = cell1; probeBaryWeight = barycentric.y;
#elif PROBE_INDEX == 2
    probeCell = cell2; probeBaryWeight = barycentric.z;
#else
    probeCell = cell3; probeBaryWeight = barycentric.w;
#endif
    GI_AccumulateProbe( probeCell, probeBaryWeight, diffuseBasis, worldPos, geometricNormal,
        receiverBlockerUVW, radianceCell, firstSum, secondSum, weightSum,
        confidenceSum, injectionVisibilitySum, rejectionSum, shDirectionSum, shDCSum );

    float3 indirectNumerator = firstSum;
#if SECOND_BOUNCE
    indirectNumerator += secondSum * g_RHSettings.w;
#endif

    float luminance = dot( indirectNumerator, float3( 0.2126f, 0.7152f, 0.0722f ) );
    indirectNumerator = lerp( luminance.xxx, indirectNumerator, g_RHQuality.x );
    indirectNumerator = min( max( indirectNumerator, 0.0f ),
        max( g_RHQuality.y, 0.25f ) * weightSum );
    float outputWeight = weightSum * volumeMask;
    indirectNumerator *= g_RHSettings.z * volumeMask;

    // Diagnostics are shader permutations rather than runtime branches. This
    // keeps both the production receiver and every debug view below the legacy
    // ps_3_0 compiler's practical instruction limit.
#if DEBUG_MODE == 1
    indirectNumerator = firstSum * volumeMask;
#elif DEBUG_MODE == 2
    indirectNumerator = secondSum * volumeMask;
#elif DEBUG_MODE == 3
    outputWeight = max( probeBaryWeight, 0.0f ) * volumeMask;
    indirectNumerator = ( g_GIClipBlend.x < 0.5f
        ? float3( 1.0f, 0.0f, 0.0f ) : float3( 0.0f, 0.0f, 1.0f ) ) * outputWeight;
#elif DEBUG_MODE == 4
    float anisotropy = saturate( length( shDirectionSum ) / max( shDCSum * 1.7320508f, 1.0e-5f ) );
    float3 directionColour = RH_SafeNormalize( shDirectionSum, float3( 0.0f, 0.0f, 1.0f ) ) * 0.5f + 0.5f;
    indirectNumerator = lerp( saturate( shDCSum / max( g_RHQuality.y, 0.25f ) ).xxx,
        directionColour, anisotropy ) * outputWeight;
#elif DEBUG_MODE == 5
    outputWeight = max( probeBaryWeight, 0.0f ) * volumeMask;
    indirectNumerator = confidenceSum.xxx * volumeMask;
#elif DEBUG_MODE == 6 || DEBUG_MODE == 7
    float4 receiverField = RH_SampleShadowAtlas( sBlockerField, receiverBlockerUVW );
    outputWeight = max( probeBaryWeight, 0.0f ) * volumeMask;
# if DEBUG_MODE == 6
    float diagnostic = RH_BlockerOpacity( receiverField ) *
        step( RH_BlockerDistanceCells( receiverField ), 0.08f );
# else
    float diagnostic = saturate( RH_BlockerDistanceCells( receiverField ) /
        RH_SHADOW_DISTANCE_MAX_CELLS );
# endif
    indirectNumerator = diagnostic.xxx * outputWeight;
#elif DEBUG_MODE == 8
    outputWeight = max( probeBaryWeight, 0.0f ) * volumeMask;
    indirectNumerator = RH_SampleAtlas( sSurfaceCache, uvw ).rgb * outputWeight;
#elif DEBUG_MODE == 9
    outputWeight = max( probeBaryWeight, 0.0f ) * volumeMask;
    indirectNumerator = injectionVisibilitySum.xxx * volumeMask;
#elif DEBUG_MODE == 10
    outputWeight = max( probeBaryWeight, 0.0f ) * volumeMask;
    indirectNumerator = rejectionSum.xxx * volumeMask;
#endif

    return float4( indirectNumerator, outputWeight );
}
