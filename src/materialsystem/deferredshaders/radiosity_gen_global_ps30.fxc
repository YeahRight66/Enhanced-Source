// STATIC: "SURFACE_MODE" "0..2"
// STATIC: "SAMPLE_PHASE" "0..3"
// 0 = sun-RSM radiance, 1 = surface attributes, 2 = hemisphere skylight.

#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"
#include "radiance_hints_common_fxc.h"

const float4x4 g_matWorldToRSM  : register( c0 );
const float4x4 g_matRSMToWorld  : register( c4 );
const float3   g_vecGridOrigin  : register( c8 );
// x = volume extent, y = cell size, z = gather radius, w = injection gain.
const float4   g_vecRHSettings  : register( c9 );
// x = RSM edge fade, y = max radiance, z = inverse RSM resolution, w = RSM world side.
const float4   g_vecRHQuality   : register( c10 );
// rgb = scaled upper hemisphere colour, w = sky enabled.
const float4   g_vecRHSkyUpper : register( c11 );
// rgb = scaled lower hemisphere colour, w = sky master intensity.
const float4   g_vecRHSkyLower : register( c12 );
// x = sky extinction, y = sky trace distance cells, z = surface gather radius cells.
const float4   g_vecRHSkySurface : register( c13 );
// x adaptive gather enable, y near radius cells, z far radius cells, w relocation cells.
const float4   g_vecRHAdaptive : register( c14 );
// x surface-guide enable/blend.
const float4   g_vecRHSurfaceGuideSettings : register( c15 );

sampler sRSMFlux       : register( s0 );
sampler sRSMNormal     : register( s1 );
sampler sRSMDepth      : register( s2 );
sampler sRSMAlbedo     : register( s3 );
sampler sGeometry      : register( s4 );
sampler sGeometryDist  : register( s5 );
sampler sShadowDist    : register( s6 );
sampler sSurfaceGuide  : register( s7 );

struct PS_INPUT
{
    float3 vVolumeUVW : TEXCOORD0;
    float2 vAtlasUV   : TEXCOORD1;
};

struct PS_OUTPUT
{
    float4 vSH_R : COLOR0;
    float4 vSH_G : COLOR1;
    float4 vSH_B : COLOR2;
    float4 vMeta : COLOR3;
};

#if SURFACE_MODE != 2
float3 RH_ReconstructRSMPosition( float2 uv, float depth )
{
    float4 world = mul( float4( uv, depth, 1.0f ), g_matRSMToWorld );
    return world.xyz / max( abs( world.w ), 1.0e-6f );
}
#endif

#if SURFACE_MODE == 1
// Scoped macro: old Source FXC reliably reuses the same temporaries for every
// compile-time sample and does not need sampler-heavy accumulator helper calls.
#define RH_ACCUMULATE_SURFACE_SAMPLE( OX, OY ) \
{ \
    float rhSurfaceRadiusWorld = max( g_vecRHSkySurface.z, 0.5f ) * max( g_vecRHSettings.y, 1.0f ); \
    float2 rhUV = centerUV + float2( OX, OY ) * ( rhSurfaceRadiusWorld / max( g_vecRHQuality.w, 1.0f ) ); \
    float rhInside = step( 0.0f, rhUV.x ) * step( rhUV.x, 1.0f ) * step( 0.0f, rhUV.y ) * step( rhUV.y, 1.0f ); \
    rhUV = saturate( rhUV ); \
    float rhDepth = tex2Dlod( sRSMDepth, float4( rhUV, 0.0f, 0.0f ) ).r; \
    float rhValid = rhInside * step( rhDepth, 0.9999f ); \
    float3 rhSurfacePosition = RH_ReconstructRSMPosition( rhUV, rhDepth ); \
    float3 rhDelta = rhSurfacePosition - cellCenterWS; \
    float rhDistanceCells = length( rhDelta ) / max( g_vecRHSettings.y, 1.0f ); \
    float rhRadiusCells = max( g_vecRHSkySurface.z, 0.5f ); \
    float rhRadial = saturate( 1.0f - rhDistanceCells / rhRadiusCells ); \
    rhRadial *= rhRadial; \
    float4 rhAlbedo = tex2Dlod( sRSMAlbedo, float4( rhUV, 0.0f, 0.0f ) ); \
    float3 rhNormal = tex2Dlod( sRSMNormal, float4( rhUV, 0.0f, 0.0f ) ).xyz * 2.0f - 1.0f; \
    rhNormal = RH_SafeNormalize( rhNormal, float3( 0.0f, 0.0f, 1.0f ) ); \
    float rhWeight = rhValid * rhRadial * step( 1.0e-4f, rhAlbedo.a ); \
    albedoSum += max( rhAlbedo.rgb, 0.0f ) * rhWeight; \
    normalSum += rhNormal * rhWeight; \
    weightSum += rhWeight; \
}
#elif SURFACE_MODE == 0
// RH7: each compile-time sample evaluates a different stable point inside the
// RH cell as well as a stratified RSM location. The 16-sample set has zero
// centroid and paired reflections, so it keeps the RH6 mirror-stability fix while
// removing the cell-centre correlation that made sparse injection look blocky.
#define RH_ACCUMULATE_RADIANCE_SAMPLE( OX, OY, SX, SY, SZ ) \
{ \
    float3 rhCellSampleWS = cellCenterWS + float3( SX, SY, SZ ) * g_vecRHSettings.y; \
    float4 rhProjectedCell = mul( float4( rhCellSampleWS, 1.0f ), g_matWorldToRSM ); \
    float2 rhSampleCenterUV = rhProjectedCell.xy / max( abs( rhProjectedCell.w ), 1.0e-6f ); \
    float2 rhUV = rhSampleCenterUV + float2( OX, OY ) * ( gatherWorldRadius / max( g_vecRHQuality.w, 1.0f ) ); \
    float rhInside = step( 0.0f, rhUV.x ) * step( rhUV.x, 1.0f ) * step( 0.0f, rhUV.y ) * step( rhUV.y, 1.0f ); \
    rhUV = saturate( rhUV ); \
    float rhEdge = min( min( rhUV.x, rhUV.y ), min( 1.0f - rhUV.x, 1.0f - rhUV.y ) ); \
    rhEdge = saturate( rhEdge / max( g_vecRHQuality.x, 1.0e-4f ) ); \
    rhEdge = rhEdge * rhEdge * ( 3.0f - 2.0f * rhEdge ); \
    float rhDepth = tex2Dlod( sRSMDepth, float4( rhUV, 0.0f, 0.0f ) ).r; \
    float rhValidDepth = rhInside * rhEdge * step( rhDepth, 0.9999f ); \
    float3 rhRay = rhCellSampleWS - RH_ReconstructRSMPosition( rhUV, rhDepth ); \
    float rhDistanceSquared = dot( rhRay, rhRay ); \
    float rhValidDistance = step( 1.0e-4f, rhDistanceSquared ); \
    float rhInverseDistance = rsqrt( max( rhDistanceSquared, 1.0e-4f ) ); \
    float rhDistanceValue = rhDistanceSquared * rhInverseDistance; \
    float rhDistanceCells = rhDistanceValue / max( g_vecRHSettings.y, 1.0f ); \
    float rhDistanceNormalized = saturate( rhDistanceValue / max( gatherWorldRadius, 1.0f ) ); \
    float rhRadial = max( 1.0f - rhDistanceNormalized * rhDistanceNormalized, 0.0f ); \
    float4 rhFlux = tex2Dlod( sRSMFlux, float4( rhUV, 0.0f, 0.0f ) ); \
    float rhFluxValid = step( 1.0e-8f, dot( rhFlux.rgb, rhFlux.rgb ) ) * step( 1.0e-4f, rhFlux.a ); \
    float3 rhNormal = tex2Dlod( sRSMNormal, float4( rhUV, 0.0f, 0.0f ) ).xyz * 2.0f - 1.0f; \
    rhNormal = RH_SafeNormalize( rhNormal, float3( 0.0f, 0.0f, 1.0f ) ); \
    float3 rhTravelDirection = rhRay * rhInverseDistance; \
    float rhEmitterCosine = saturate( dot( rhNormal, rhTravelDirection ) ); \
    float rhSoftening = g_vecRHSettings.y * g_vecRHSettings.y * 0.1225f; \
    float rhGeometryTerm = rhEmitterCosine * sampleProjectedArea / max( rhDistanceSquared + rhSoftening, 1.0f ); \
    float rhSampleWeight = rhValidDepth * rhValidDistance * rhFluxValid * rhRadial; \
    float3 rhTransported = RH_ClampRadiance( rhFlux.rgb * ( rhGeometryTerm * rhSampleWeight * g_vecRHSettings.w ), max( g_vecRHQuality.y, 0.25f ) ); \
    float4 rhBasis = RH_ProjectDirection( rhTravelDirection ); \
    shR += rhBasis * rhTransported.r; \
    shG += rhBasis * rhTransported.g; \
    shB += rhBasis * rhTransported.b; \
    confidenceSum += rhSampleWeight; \
    nearestDistanceCells = min( nearestDistanceCells, lerp( 65504.0f, rhDistanceCells, step( 1.0e-5f, rhSampleWeight ) ) ); \
}
#else
// Five explicit lobes per permutation. The complete sky is assembled by two
// additive draws, avoiding nested sampler-heavy helper calls in legacy FXC.
#define RH_ACCUMULATE_UPPER_SKY( DX, DY, DZ, WEIGHT ) \
{ \
    float3 rhSkyDirection = float3( DX, DY, DZ ); \
    float rhTraceCells = clamp( g_vecRHSkySurface.y, 1.0f, 16.0f ); \
    float rhSampleCells = clamp( rhTraceCells * 0.45f, 0.80f, 5.0f ); \
    float3 rhSampleUVW = In.vVolumeUVW + rhSkyDirection * ( rhSampleCells / RH_VOLUME_SIZE_F ); \
    float rhInside = RH_InsideVolume( rhSampleUVW ); \
    float rhBlocker = RH_SampleAtlas( sGeometry, rhSampleUVW ).r; \
    float rhDistanceCells = RH_SampleAtlas( sGeometryDist, rhSampleUVW ).r * 255.0f; \
    float rhProximity = saturate( 1.0f - rhDistanceCells / max( rhTraceCells, 1.0f ) ); \
    float rhOpticalDepth = max( rhBlocker, rhProximity * 0.35f ) * rhSampleCells * rhInside; \
    float rhVisibility = exp2( -max( g_vecRHSkySurface.x, 0.0f ) * rhOpticalDepth ); \
    skyBasis += RH_ProjectDirection( -rhSkyDirection ) * ( WEIGHT * rhVisibility ); \
}

#define RH_ACCUMULATE_LOWER_SKY( DX, DY, DZ, WEIGHT ) \
{ \
    float3 rhSkyDirection = float3( DX, DY, DZ ); \
    float rhTraceCells = clamp( g_vecRHSkySurface.y, 1.0f, 16.0f ); \
    float rhSampleCells = clamp( rhTraceCells * 0.30f, 0.70f, 3.5f ); \
    float3 rhSampleUVW = In.vVolumeUVW + rhSkyDirection * ( rhSampleCells / RH_VOLUME_SIZE_F ); \
    float rhBlocker = RH_SampleAtlas( sGeometry, rhSampleUVW ).r * RH_InsideVolume( rhSampleUVW ); \
    float rhVisibility = exp2( -max( g_vecRHSkySurface.x, 0.0f ) * rhBlocker * rhSampleCells ); \
    skyBasis += RH_ProjectDirection( -rhSkyDirection ) * ( WEIGHT * rhVisibility ); \
}
#endif

PS_OUTPUT main( const PS_INPUT In )
{
    PS_OUTPUT Out;

#if SURFACE_MODE == 1
    float4 surfaceGuide = RH_SampleAtlas( sSurfaceGuide, In.vVolumeUVW );
    float guideAmount = saturate( surfaceGuide.a ) * saturate( g_vecRHSurfaceGuideSettings.x );
    float3 guideNormal = RH_DecodeSurfaceGuideNormal( surfaceGuide );
    float3 relocatedUVW = In.vVolumeUVW + guideNormal * ( guideAmount * clamp( g_vecRHAdaptive.w, 0.0f, 0.45f ) / RH_VOLUME_SIZE_F );
    float3 cellCenterWS = g_vecGridOrigin + relocatedUVW * g_vecRHSettings.x;
    float4 projected = mul( float4( cellCenterWS, 1.0f ), g_matWorldToRSM );
    float2 centerUV = projected.xy / max( abs( projected.w ), 1.0e-6f );
    float3 albedoSum = 0.0f;
    float3 normalSum = 0.0f;
    float weightSum = 0.0f;

#if SAMPLE_PHASE == 0
    RH_ACCUMULATE_SURFACE_SAMPLE( 0.32f, 0.00f );
    RH_ACCUMULATE_SURFACE_SAMPLE(-0.32f, 0.00f );
    RH_ACCUMULATE_SURFACE_SAMPLE( 0.00f, 0.32f );
    RH_ACCUMULATE_SURFACE_SAMPLE( 0.00f,-0.32f );
#elif SAMPLE_PHASE == 1
    RH_ACCUMULATE_SURFACE_SAMPLE( 0.52f, 0.52f );
    RH_ACCUMULATE_SURFACE_SAMPLE(-0.52f, 0.52f );
    RH_ACCUMULATE_SURFACE_SAMPLE( 0.52f,-0.52f );
    RH_ACCUMULATE_SURFACE_SAMPLE(-0.52f,-0.52f );
#endif

    Out.vSH_R = float4( albedoSum, weightSum );
    Out.vSH_G = float4( normalSum, weightSum );
    Out.vSH_B = 0.0f;
    Out.vMeta = 0.0f;
#elif SURFACE_MODE == 0
    float4 surfaceGuide = RH_SampleAtlas( sSurfaceGuide, In.vVolumeUVW );
    float guideAmount = saturate( surfaceGuide.a ) * saturate( g_vecRHSurfaceGuideSettings.x );
    float3 guideNormal = RH_DecodeSurfaceGuideNormal( surfaceGuide );
    float3 relocatedUVW = In.vVolumeUVW + guideNormal * ( guideAmount * clamp( g_vecRHAdaptive.w, 0.0f, 0.45f ) / RH_VOLUME_SIZE_F );
    float3 cellCenterWS = g_vecGridOrigin + relocatedUVW * g_vecRHSettings.x;
    float4 shR = 0.0f;
    float4 shG = 0.0f;
    float4 shB = 0.0f;
    float confidenceSum = 0.0f;
    float nearestDistanceCells = 65504.0f;
    float shadowDistanceCells = RH_ShadowDistanceCells( sShadowDist, In.vVolumeUVW );
    float distanceRadianceCells = shadowDistanceCells * ( RH_VOLUME_SIZE_F / RH_SHADOW_VOLUME_SIZE_F );
    float adaptiveT = saturate( distanceRadianceCells / 4.0f );
    float adaptiveGatherCells = lerp( max( g_vecRHAdaptive.y, 1.0f ), max( g_vecRHAdaptive.z, 1.0f ), adaptiveT );
    float baseGatherCells = g_vecRHSettings.z / max( g_vecRHSettings.y, 1.0f );
    float gatherCellsLocal = lerp( baseGatherCells, adaptiveGatherCells, saturate( g_vecRHAdaptive.x ) );
    float gatherWorldRadius = gatherCellsLocal * max( g_vecRHSettings.y, 1.0f );
    float sampleProjectedArea = 2.0f * RH_PI * gatherWorldRadius * gatherWorldRadius
        / RH_RADIANCE_SAMPLE_COUNT;

#if SAMPLE_PHASE == 0
    // Cardinal stratum above the cell centre. Phase 1 is its exact Z reflection.
    RH_ACCUMULATE_RADIANCE_SAMPLE( 0.32f, 0.00f,  0.24f, 0.00f, 0.25f );
    RH_ACCUMULATE_RADIANCE_SAMPLE(-0.32f, 0.00f, -0.24f, 0.00f, 0.25f );
    RH_ACCUMULATE_RADIANCE_SAMPLE( 0.00f, 0.32f,  0.00f, 0.24f, 0.25f );
    RH_ACCUMULATE_RADIANCE_SAMPLE( 0.00f,-0.32f,  0.00f,-0.24f, 0.25f );
#elif SAMPLE_PHASE == 1
#if RH_RADIANCE_SAMPLE_COUNT >= 8
    // Exact Z-reflected cardinal stratum. Together phases 0/1 have zero 3D centroid.
    RH_ACCUMULATE_RADIANCE_SAMPLE( 0.32f, 0.00f,  0.24f, 0.00f,-0.25f );
    RH_ACCUMULATE_RADIANCE_SAMPLE(-0.32f, 0.00f, -0.24f, 0.00f,-0.25f );
    RH_ACCUMULATE_RADIANCE_SAMPLE( 0.00f, 0.32f,  0.00f, 0.24f,-0.25f );
    RH_ACCUMULATE_RADIANCE_SAMPLE( 0.00f,-0.32f,  0.00f,-0.24f,-0.25f );
#endif
#elif SAMPLE_PHASE == 2
#if RH_RADIANCE_SAMPLE_COUNT >= 16
    // Diagonal stratum above the cell centre. Phase 3 is its exact Z reflection.
    RH_ACCUMULATE_RADIANCE_SAMPLE( 0.52f, 0.52f,  0.20f, 0.20f, 0.25f );
    RH_ACCUMULATE_RADIANCE_SAMPLE(-0.52f, 0.52f, -0.20f, 0.20f, 0.25f );
    RH_ACCUMULATE_RADIANCE_SAMPLE( 0.52f,-0.52f,  0.20f,-0.20f, 0.25f );
    RH_ACCUMULATE_RADIANCE_SAMPLE(-0.52f,-0.52f, -0.20f,-0.20f, 0.25f );
#endif
#else
#if RH_RADIANCE_SAMPLE_COUNT >= 16
    // Exact Z-reflected diagonal stratum. The full 16-sample set is reflection paired in X/Y/Z.
    RH_ACCUMULATE_RADIANCE_SAMPLE( 0.52f, 0.52f,  0.20f, 0.20f,-0.25f );
    RH_ACCUMULATE_RADIANCE_SAMPLE(-0.52f, 0.52f, -0.20f, 0.20f,-0.25f );
    RH_ACCUMULATE_RADIANCE_SAMPLE( 0.52f,-0.52f,  0.20f,-0.20f,-0.25f );
    RH_ACCUMULATE_RADIANCE_SAMPLE(-0.52f,-0.52f, -0.20f,-0.20f,-0.25f );
#endif
#endif

    Out.vSH_R = RH_LimitRadianceSH( shR );
    Out.vSH_G = RH_LimitRadianceSH( shG );
    Out.vSH_B = RH_LimitRadianceSH( shB );
    float valid = step( 1.0e-5f, confidenceSum );
    float gatherCells = max( gatherCellsLocal, 1.0f );
    float normalizedEnergy = saturate(
        RH_RadianceEnergy( Out.vSH_R, Out.vSH_G, Out.vSH_B )
        / max( g_vecRHQuality.y, 0.25f ) );
#if SAMPLE_PHASE == 0
    Out.vMeta = float4(
        saturate( confidenceSum / RH_RADIANCE_SAMPLE_COUNT ),
        valid * saturate( nearestDistanceCells / gatherCells ) + ( 1.0f - valid ),
        normalizedEnergy,
        valid );
#else
    // Added to phase 0. Distance is retained from the nearest inner-cardinal stratum;
    // confidence, energy and validity accumulate all later stratified phases.
    Out.vMeta = float4(
        saturate( confidenceSum / RH_RADIANCE_SAMPLE_COUNT ),
        0.0f,
        normalizedEnergy,
        valid );
#endif
#else
    const float horizontal = 0.9682458366f;
    float skyEnabled = saturate( g_vecRHSkyUpper.w );
    float skyIntensity = max( g_vecRHSkyLower.w, 0.0f ) * skyEnabled;
    float3 upperSky = max( g_vecRHSkyUpper.rgb, 0.0f ) * skyIntensity;
    float3 lowerSky = max( g_vecRHSkyLower.rgb, 0.0f ) * skyIntensity;

    float4 skyBasis = 0.0f;
    float3 skyColour = 0.0f;
#if SAMPLE_PHASE == 0
    RH_ACCUMULATE_UPPER_SKY( 0.0f, 0.0f, 1.0f, 2.0943951024f );
    RH_ACCUMULATE_UPPER_SKY( horizontal, 0.0f, 0.25f, 1.0471975512f );
    RH_ACCUMULATE_UPPER_SKY(-horizontal, 0.0f, 0.25f, 1.0471975512f );
    RH_ACCUMULATE_UPPER_SKY( 0.0f, horizontal, 0.25f, 1.0471975512f );
    RH_ACCUMULATE_UPPER_SKY( 0.0f,-horizontal, 0.25f, 1.0471975512f );
    skyColour = upperSky;
#else
    RH_ACCUMULATE_LOWER_SKY( 0.0f, 0.0f,-1.0f, 2.0943951024f );
    RH_ACCUMULATE_LOWER_SKY( horizontal, 0.0f,-0.25f, 1.0471975512f );
    RH_ACCUMULATE_LOWER_SKY(-horizontal, 0.0f,-0.25f, 1.0471975512f );
    RH_ACCUMULATE_LOWER_SKY( 0.0f, horizontal,-0.25f, 1.0471975512f );
    RH_ACCUMULATE_LOWER_SKY( 0.0f,-horizontal,-0.25f, 1.0471975512f );
    skyColour = lowerSky;
#endif

    Out.vSH_R = RH_LimitRadianceSH( skyBasis * skyColour.r );
    Out.vSH_G = RH_LimitRadianceSH( skyBasis * skyColour.g );
    Out.vSH_B = RH_LimitRadianceSH( skyBasis * skyColour.b );
    float skyEnergy = RH_RadianceEnergy( Out.vSH_R, Out.vSH_G, Out.vSH_B );
    float valid = step( 1.0e-5f, skyEnergy );
    Out.vMeta = float4(
        saturate( skyEnergy / max( g_vecRHQuality.y, 0.25f ) ),
        0.5f,
        saturate( skyEnergy / max( g_vecRHQuality.y, 0.25f ) ),
        valid * 0.5f );
#endif
    return Out;
}
