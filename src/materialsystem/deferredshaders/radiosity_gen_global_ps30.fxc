#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"
#include "radiance_hints_common_fxc.h"

const float3 g_vecGridOrigin              : register( c0 );
const float4x3 g_matOrtho                 : register( c1 );
const float4 g_vecUVTransform             : register( c4 );
const float4 g_vecSlopeSettings           : register( c5 );
const float3 g_vecShadowOrigin            : register( c6 );
const float3 g_vecShadowForward           : register( c7 );
// x = volume extent, y = cell size, z = world spread distance, w = injection gain
const float4 g_vecRHSettings              : register( c8 );
// x = RSM edge fade in local UV, y = maximum transported radiance
const float4 g_vecRHQualitySettings       : register( c9 );
// x = geometry enable, y = solid inner radius in cells,
// z = occupancy outer radius in cells, w = occupancy strength
const float4 g_vecRHGeometrySettings      : register( c10 );

sampler sShadowFlux                       : register( s0 );
sampler sShadowNormal                     : register( s1 );
sampler sShadowDepth                      : register( s2 );

struct PS_INPUT
{
	float3 vVolumeUVW : TEXCOORD0;
	float2 vAtlasUV   : TEXCOORD1;
};

struct PS_OUTPUT
{
	float4 vSH_R : COLOR0;
	float4 vSH_G : COLOR1;
	float4 vSH_B : COLOR2;
	float4 vAux  : COLOR3;
};

float3 RH_ReconstructRSMWorldPosition( float2 localUV, float depth )
{
	float3 rowX = float3( g_matOrtho[0][0], g_matOrtho[1][0], g_matOrtho[2][0] );
	float3 rowY = float3( g_matOrtho[0][1], g_matOrtho[1][1], g_matOrtho[2][1] );
	float3 rowZ = g_vecShadowForward * g_vecSlopeSettings.w;

	float3 rhs;
	rhs.x = localUV.x - g_matOrtho[3][0];
	rhs.y = localUV.y - g_matOrtho[3][1];
	rhs.z = depth + dot( g_vecShadowOrigin, rowZ );

	float3 crossYZ = cross( rowY, rowZ );
	float determinant = dot( rowX, crossYZ );
	float determinantSign = determinant < 0.0f ? -1.0f : 1.0f;
	float safeDeterminant = determinantSign * max( abs( determinant ), 1.0e-7f );

	return ( rhs.x * crossYZ + rhs.y * cross( rowZ, rowX ) + rhs.z * cross( rowX, rowY ) ) / safeDeterminant;
}

void RH_AccumulateRSM(
	float2 localCenterUV,
	float2 diskOffset,
	float3 cellJitter,
	float2 patternSinCos,
	float3 cellCenterWS,
	float2 worldToLocalUV,
	inout float4 shR,
	inout float4 shG,
	inout float4 shB,
	inout float minDistance,
	inout float maxDistance,
	inout float validCount,
	inout float occupancy )
{
	float2 rotatedDiskOffset = RH_Rotate2D( diskOffset, patternSinCos.x, patternSinCos.y );
	float2 rotatedJitterXY = RH_Rotate2D( cellJitter.xy, patternSinCos.x, patternSinCos.y );
	cellJitter.xy = rotatedJitterXY;

	float2 localUV = localCenterUV + rotatedDiskOffset * worldToLocalUV * g_vecRHSettings.z;
	float inside = step( 0.0f, localUV.x ) * step( localUV.x, 1.0f )
		* step( 0.0f, localUV.y ) * step( localUV.y, 1.0f );

	float2 safeLocalUV = saturate( localUV );
	float2 atlasUV = safeLocalUV * g_vecUVTransform.zw + g_vecUVTransform.xy;
	float depth = tex2D( sShadowDepth, atlasUV ).r;
	float3 flux = tex2D( sShadowFlux, atlasUV ).rgb;

	float edgeDistance = min( min( safeLocalUV.x, safeLocalUV.y ),
		min( 1.0f - safeLocalUV.x, 1.0f - safeLocalUV.y ) );
	float edgeFade = saturate( edgeDistance / max( g_vecRHQualitySettings.x, 1.0e-4f ) );
	edgeFade = edgeFade * edgeFade * ( 3.0f - 2.0f * edgeFade );

	// Geometry and radiance use separate validity masks. A black or back-facing
	// surface must still block indirect light.
	float geometryWeight = inside * edgeFade * step( depth, 0.9999f );

	[branch]
	if ( geometryWeight > 1.0e-4f )
	{
		float3 emitterPosition = RH_ReconstructRSMWorldPosition( safeLocalUV, depth );
		float geometryDistanceCells = length( cellCenterWS - emitterPosition )
			/ max( g_vecRHSettings.y, 1.0f );
		float innerRadius = max( g_vecRHGeometrySettings.y, 0.0f );
		float outerRadius = max( g_vecRHGeometrySettings.z, innerRadius + 0.01f );
		float surfaceOccupancy = 1.0f - smoothstep( innerRadius, outerRadius, geometryDistanceCells );
		occupancy = max( occupancy,
			saturate( surfaceOccupancy * geometryWeight
				* g_vecRHGeometrySettings.x * g_vecRHGeometrySettings.w ) );

		float radianceWeight = geometryWeight * step( 1.0e-7f, dot( flux, flux ) );

		[branch]
		if ( radianceWeight > 1.0e-4f )
		{
			float3 encodedNormal = tex2D( sShadowNormal, atlasUV ).xyz * 2.0f - 1.0f;
			float3 emitterNormal = RH_SafeNormalize( encodedNormal, float3( 0.0f, 0.0f, 1.0f ) );
			float3 receiverPosition = cellCenterWS + cellJitter * ( g_vecRHSettings.y * 0.45f );

			float3 ray = receiverPosition - emitterPosition;
			float distanceSquaredWS = dot( ray, ray );
			float distanceWS = sqrt( max( distanceSquaredWS, RH_EPSILON ) );
			float3 rayDirection = RH_SafeNormalize( ray, emitterNormal );
			float distanceNormalized = distanceWS / max( g_vecRHSettings.z, 1.0f );

			float distanceValid = step( 0.0025f, distanceNormalized ) * step( distanceNormalized, 1.5f );
			float geometric = saturate( dot( rayDirection, emitterNormal ) );
			float attenuation = radianceWeight * distanceValid * geometric
				/ ( 0.04f + distanceNormalized * distanceNormalized );
			float3 transported = RH_ClampRadiance(
				flux * ( attenuation * g_vecRHSettings.w ),
				max( g_vecRHQualitySettings.y, 0.25f ) );
			float4 basis = RH_ProjectDirection( rayDirection );

			shR += basis * transported.r;
			shG += basis * transported.g;
			shB += basis * transported.b;
			minDistance = min( minDistance, distanceNormalized );
			maxDistance = max( maxDistance, distanceNormalized );
			validCount += radianceWeight * distanceValid;
		}
	}
}

PS_OUTPUT main( const PS_INPUT In )
{
	PS_OUTPUT Out;
	float3 cellCenterWS = g_vecGridOrigin + In.vVolumeUVW * g_vecRHSettings.x;
	float3 projected = mul( float4( cellCenterWS, 1.0f ), g_matOrtho );
	float2 localCenterUV = projected.xy;

	float3 rowX = float3( g_matOrtho[0][0], g_matOrtho[1][0], g_matOrtho[2][0] );
	float3 rowY = float3( g_matOrtho[0][1], g_matOrtho[1][1], g_matOrtho[2][1] );
	float2 worldToLocalUV = float2( length( rowX ), length( rowY ) );

	float3 cellCoordinate = floor( In.vVolumeUVW * RH_VOLUME_SIZE_F );
	float patternQuadrant = floor( RH_Hash13( cellCoordinate + float3( 11.0f, 37.0f, 73.0f ) ) * 4.0f );
	float2 patternSinCos = float2( 0.0f, 1.0f );
	if ( patternQuadrant < 1.0f ) patternSinCos = float2( 0.0f,  1.0f );
	else if ( patternQuadrant < 2.0f ) patternSinCos = float2( 1.0f,  0.0f );
	else if ( patternQuadrant < 3.0f ) patternSinCos = float2( 0.0f, -1.0f );
	else patternSinCos = float2( -1.0f, 0.0f );

	float4 shR = 0.0f;
	float4 shG = 0.0f;
	float4 shB = 0.0f;
	float minDistance = 1.0f;
	float maxDistance = 0.0f;
	float validCount = 0.0f;
	float occupancy = 0.0f;

#if RH_RSM_SAMPLE_COUNT >= 1
	RH_AccumulateRSM( localCenterUV, float2( 0.000f,  0.000f ), float3( 0.17f, -0.31f,  0.23f ), patternSinCos, cellCenterWS, worldToLocalUV, shR, shG, shB, minDistance, maxDistance, validCount, occupancy );
#endif
#if RH_RSM_SAMPLE_COUNT >= 2
	RH_AccumulateRSM( localCenterUV, float2( 0.527f,  0.143f ), float3(-0.36f,  0.11f, -0.19f ), patternSinCos, cellCenterWS, worldToLocalUV, shR, shG, shB, minDistance, maxDistance, validCount, occupancy );
#endif
#if RH_RSM_SAMPLE_COUNT >= 3
	RH_AccumulateRSM( localCenterUV, float2(-0.401f,  0.388f ), float3( 0.28f,  0.37f, -0.27f ), patternSinCos, cellCenterWS, worldToLocalUV, shR, shG, shB, minDistance, maxDistance, validCount, occupancy );
#endif
#if RH_RSM_SAMPLE_COUNT >= 4
	RH_AccumulateRSM( localCenterUV, float2( 0.118f, -0.591f ), float3(-0.12f, -0.22f,  0.39f ), patternSinCos, cellCenterWS, worldToLocalUV, shR, shG, shB, minDistance, maxDistance, validCount, occupancy );
#endif
#if RH_RSM_SAMPLE_COUNT >= 5
	RH_AccumulateRSM( localCenterUV, float2(-0.684f, -0.104f ), float3( 0.41f, -0.08f, -0.33f ), patternSinCos, cellCenterWS, worldToLocalUV, shR, shG, shB, minDistance, maxDistance, validCount, occupancy );
#endif
#if RH_RSM_SAMPLE_COUNT >= 6
	RH_AccumulateRSM( localCenterUV, float2( 0.632f, -0.477f ), float3(-0.29f,  0.32f,  0.07f ), patternSinCos, cellCenterWS, worldToLocalUV, shR, shG, shB, minDistance, maxDistance, validCount, occupancy );
#endif
#if RH_RSM_SAMPLE_COUNT >= 7
	RH_AccumulateRSM( localCenterUV, float2(-0.214f,  0.779f ), float3( 0.06f, -0.44f, -0.11f ), patternSinCos, cellCenterWS, worldToLocalUV, shR, shG, shB, minDistance, maxDistance, validCount, occupancy );
#endif
#if RH_RSM_SAMPLE_COUNT >= 8
	RH_AccumulateRSM( localCenterUV, float2( 0.806f,  0.326f ), float3(-0.43f,  0.19f,  0.31f ), patternSinCos, cellCenterWS, worldToLocalUV, shR, shG, shB, minDistance, maxDistance, validCount, occupancy );
#endif

	float hasSamples = step( 1.0e-4f, validCount );
	float normalization = hasSamples / ( RH_PI * max( validCount, 1.0e-4f ) );
	float confidence = saturate( validCount * ( 2.0f / RH_RSM_SAMPLE_COUNT ) );
	confidence = confidence * confidence * ( 3.0f - 2.0f * confidence );

	Out.vSH_R = RH_DeringSH( shR * normalization );
	Out.vSH_G = RH_DeringSH( shG * normalization );
	Out.vSH_B = RH_DeringSH( shB * normalization );
	Out.vAux = float4(
		lerp( 1.0f, minDistance, hasSamples ),
		maxDistance,
		confidence,
		saturate( occupancy ) );
	return Out;
}
