// STATIC: "SURFACE_MODE" "0..2"
// 0 = sun-RSM radiance, 1 = surface attributes, 2 = hemisphere skylight.

#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"
#include "radiance_hints_common_fxc.h"

const float4x4 g_matWorldToRSM  : register( c0 );
const float4x4 g_matRSMToWorld  : register( c4 );
const float3   g_vecGridOrigin  : register( c8 );
// x = volume extent, y = cell size, z = gather radius, w = injection gain.
const float4   g_vecRHSettings  : register( c9 );
// x = RSM edge fade, y = max radiance, z = inverse RSM resolution, w = RSM world side.
const float4   g_vecRHQuality   : register( c10 );
// rgb = scaled upper hemisphere colour, w = sky enabled.
const float4   g_vecRHSkyUpper : register( c11 );
// rgb = scaled lower hemisphere colour, w = sky master intensity.
const float4   g_vecRHSkyLower : register( c12 );
// x = sky extinction, y = sky trace distance cells, z = surface gather radius cells.
const float4   g_vecRHSkySurface : register( c13 );

sampler sRSMFlux       : register( s0 );
sampler sRSMNormal     : register( s1 );
sampler sRSMDepth      : register( s2 );
sampler sRSMAlbedo     : register( s3 );
sampler sGeometry      : register( s4 );
sampler sGeometryDist  : register( s5 );

struct PS_INPUT
{
    float3 vVolumeUVW : TEXCOORD0;
    float2 vAtlasUV   : TEXCOORD1;
};

struct PS_OUTPUT
{
    float4 vSH_R : COLOR0;
    float4 vSH_G : COLOR1;
    float4 vSH_B : COLOR2;
    float4 vMeta : COLOR3;
};

#if SURFACE_MODE != 2
float3 RH_ReconstructRSMPosition( float2 uv, float depth )
{
    float4 world = mul( float4( uv, depth, 1.0f ), g_matRSMToWorld );
    return world.xyz / max( abs( world.w ), 1.0e-6f );
}

// Exact D4/reflection-symmetric set. Its centroid is zero, so mirrored rooms
// receive mathematically mirrored RSM gathers.
float2 RH_GetSymmetricRSMOffset( int sampleIndex )
{
    if ( sampleIndex == 0 ) return float2( 0.32f,  0.00f );
    if ( sampleIndex == 1 ) return float2(-0.32f,  0.00f );
    if ( sampleIndex == 2 ) return float2( 0.00f,  0.32f );
    if ( sampleIndex == 3 ) return float2( 0.00f, -0.32f );
    if ( sampleIndex == 4 ) return float2( 0.52f,  0.52f );
    if ( sampleIndex == 5 ) return float2(-0.52f,  0.52f );
    if ( sampleIndex == 6 ) return float2( 0.52f, -0.52f );
    return float2(-0.52f, -0.52f );
}
#endif

#if SURFACE_MODE == 1
void RH_AccumulateSurface(
    float2 centerUV,
    float2 diskOffset,
    float3 cellCenterWS,
    inout float3 albedoSum,
    inout float3 normalSum,
    inout float weightSum )
{
    float surfaceRadiusWorld = max( g_vecRHSkySurface.z, 0.5f ) * max( g_vecRHSettings.y, 1.0f );
    float2 uv = centerUV + diskOffset * ( surfaceRadiusWorld / max( g_vecRHQuality.w, 1.0f ) );
    float inside = step( 0.0f, uv.x ) * step( uv.x, 1.0f )
        * step( 0.0f, uv.y ) * step( uv.y, 1.0f );
    uv = saturate( uv );

    float depth = tex2Dlod( sRSMDepth, float4( uv, 0.0f, 0.0f ) ).r;
    float valid = inside * step( depth, 0.9999f );
    [branch]
    if ( valid > 0.0f )
    {
        float3 surfacePosition = RH_ReconstructRSMPosition( uv, depth );
        float3 delta = surfacePosition - cellCenterWS;
        float distanceCells = length( delta ) / max( g_vecRHSettings.y, 1.0f );
        float radiusCells = max( g_vecRHSkySurface.z, 0.5f );
        float radial = saturate( 1.0f - distanceCells / radiusCells );
        radial *= radial;

        float4 albedo = tex2Dlod( sRSMAlbedo, float4( uv, 0.0f, 0.0f ) );
        float3 normal = tex2Dlod( sRSMNormal, float4( uv, 0.0f, 0.0f ) ).xyz * 2.0f - 1.0f;
        normal = RH_SafeNormalize( normal, float3( 0.0f, 0.0f, 1.0f ) );
        float weight = valid * radial * step( 1.0e-4f, albedo.a );
        albedoSum += max( albedo.rgb, 0.0f ) * weight;
        normalSum += normal * weight;
        weightSum += weight;
    }
}
#elif SURFACE_MODE == 0
void RH_AccumulateRadiance(
    float2 centerUV,
    float2 diskOffset,
    float3 cellCenterWS,
    float sampleProjectedArea,
    inout float4 shR,
    inout float4 shG,
    inout float4 shB,
    inout float confidenceSum,
    inout float nearestDistanceCells )
{
    float2 uv = centerUV + diskOffset * ( g_vecRHSettings.z / max( g_vecRHQuality.w, 1.0f ) );
    float inside = step( 0.0f, uv.x ) * step( uv.x, 1.0f )
        * step( 0.0f, uv.y ) * step( uv.y, 1.0f );
    uv = saturate( uv );

    float edge = min( min( uv.x, uv.y ), min( 1.0f - uv.x, 1.0f - uv.y ) );
    edge = saturate( edge / max( g_vecRHQuality.x, 1.0e-4f ) );
    edge = edge * edge * ( 3.0f - 2.0f * edge );

    float depth = tex2Dlod( sRSMDepth, float4( uv, 0.0f, 0.0f ) ).r;
    float validDepth = inside * edge * step( depth, 0.9999f );
    [branch]
    if ( validDepth > 1.0e-4f )
    {
        float3 ray = cellCenterWS - RH_ReconstructRSMPosition( uv, depth );
        float distanceSquared = dot( ray, ray );
        [branch]
        if ( distanceSquared > 1.0e-4f )
        {
            float inverseDistance = rsqrt( distanceSquared );
            float distanceValue = distanceSquared * inverseDistance;
            float distanceCells = distanceValue / max( g_vecRHSettings.y, 1.0f );
            nearestDistanceCells = min( nearestDistanceCells, distanceCells );

            float distanceNormalized = saturate( distanceValue / max( g_vecRHSettings.z, 1.0f ) );
            float radial = max( 1.0f - distanceNormalized * distanceNormalized, 0.0f );
            float4 fluxSample = tex2Dlod( sRSMFlux, float4( uv, 0.0f, 0.0f ) );
            float fluxValid = step( 1.0e-8f, dot( fluxSample.rgb, fluxSample.rgb ) )
                * step( 1.0e-4f, fluxSample.a );
            float3 normal = tex2Dlod( sRSMNormal, float4( uv, 0.0f, 0.0f ) ).xyz * 2.0f - 1.0f;
            normal = RH_SafeNormalize( normal, float3( 0.0f, 0.0f, 1.0f ) );

            float3 travelDirection = ray * inverseDistance;
            float emitterCosine = saturate( dot( normal, travelDirection ) );
            float softening = g_vecRHSettings.y * g_vecRHSettings.y * 0.1225f;
            float geometryTerm = emitterCosine * sampleProjectedArea
                / max( distanceSquared + softening, 1.0f );
            float sampleWeight = validDepth * fluxValid * radial;
            float3 transported = RH_ClampRadiance(
                fluxSample.rgb * ( geometryTerm * sampleWeight * g_vecRHSettings.w ),
                max( g_vecRHQuality.y, 0.25f ) );

            float4 basis = RH_ProjectDirection( travelDirection );
            shR += basis * transported.r;
            shG += basis * transported.g;
            shB += basis * transported.b;
            confidenceSum += sampleWeight;
        }
    }
}
#else
float RH_SkyVisibility( float3 uvw, float3 directionToEnvironment )
{
    float traceCells = clamp( g_vecRHSkySurface.y, 1.0f, 16.0f );
    float travelCells = 0.70f;
    float opticalDepth = 0.0f;

    [unroll]
    for ( int traceIndex = 0; traceIndex < 4; ++traceIndex )
    {
        float remainingCells = max( traceCells - travelCells, 0.0f );
        float active = step( 0.05f, remainingCells );
        float3 sampleUVW = uvw + directionToEnvironment * ( travelCells / RH_VOLUME_SIZE_F );
        float inside = RH_InsideVolume( sampleUVW );
        float blocker = RH_SampleAtlas( sGeometry, sampleUVW ).r;
        float distanceCells = RH_SampleAtlas( sGeometryDist, sampleUVW ).r * 255.0f;
        float segmentCells = min( clamp( distanceCells * 0.65f, 0.70f, 3.0f ), remainingCells );
        opticalDepth += blocker * max( segmentCells, 0.25f ) * inside * active;
        travelCells += segmentCells * active;
    }
    return exp2( -max( g_vecRHSkySurface.x, 0.0f ) * opticalDepth );
}

float3 RH_GetHemisphereEnvironmentDirection( int sampleIndex, float verticalSign )
{
    const float horizontal = 0.9682458366f; // sqrt( 1 - 0.25^2 )
    if ( sampleIndex == 0 ) return float3( 0.0f, 0.0f, verticalSign );
    if ( sampleIndex == 1 ) return float3( horizontal, 0.0f, 0.25f * verticalSign );
    if ( sampleIndex == 2 ) return float3(-horizontal, 0.0f, 0.25f * verticalSign );
    if ( sampleIndex == 3 ) return float3( 0.0f, horizontal, 0.25f * verticalSign );
    return float3( 0.0f,-horizontal, 0.25f * verticalSign );
}

float RH_GetHemisphereQuadratureWeight( int sampleIndex )
{
    return sampleIndex == 0 ? 2.0943951024f : 1.0471975512f;
}

void RH_AccumulateHemisphereSky(
    float3 uvw,
    float verticalSign,
    float3 skyRadiance,
    inout float4 shR,
    inout float4 shG,
    inout float4 shB )
{
    [loop]
    for ( int skyIndex = 0; skyIndex < 5; ++skyIndex )
    {
        float3 directionToEnvironment = RH_GetHemisphereEnvironmentDirection( skyIndex, verticalSign );
        float visibility = RH_SkyVisibility( uvw, directionToEnvironment );
        float weight = RH_GetHemisphereQuadratureWeight( skyIndex ) * visibility;
        float4 basis = RH_ProjectDirection( -directionToEnvironment );
        shR += basis * ( skyRadiance.r * weight );
        shG += basis * ( skyRadiance.g * weight );
        shB += basis * ( skyRadiance.b * weight );
    }
}
#endif

PS_OUTPUT main( const PS_INPUT In )
{
    PS_OUTPUT Out;

#if SURFACE_MODE == 1
    float3 cellCenterWS = g_vecGridOrigin + In.vVolumeUVW * g_vecRHSettings.x;
    float4 projected = mul( float4( cellCenterWS, 1.0f ), g_matWorldToRSM );
    float2 centerUV = projected.xy / max( abs( projected.w ), 1.0e-6f );
    float3 albedoSum = 0.0f;
    float3 normalSum = 0.0f;
    float weightSum = 0.0f;
    [loop]
    for ( int sampleIndex = 0; sampleIndex < RH_RADIANCE_SAMPLE_COUNT; ++sampleIndex )
        RH_AccumulateSurface( centerUV, RH_GetSymmetricRSMOffset( sampleIndex ), cellCenterWS,
            albedoSum, normalSum, weightSum );

    Out.vSH_R = float4( albedoSum, weightSum );
    Out.vSH_G = float4( normalSum, weightSum );
    Out.vSH_B = 0.0f;
    Out.vMeta = 0.0f;
#elif SURFACE_MODE == 0
    float3 cellCenterWS = g_vecGridOrigin + In.vVolumeUVW * g_vecRHSettings.x;
    float4 projected = mul( float4( cellCenterWS, 1.0f ), g_matWorldToRSM );
    float2 centerUV = projected.xy / max( abs( projected.w ), 1.0e-6f );
    float4 shR = 0.0f;
    float4 shG = 0.0f;
    float4 shB = 0.0f;
    float confidenceSum = 0.0f;
    float nearestDistanceCells = 65504.0f;
    float sampleProjectedArea = 2.0f * RH_PI * g_vecRHSettings.z * g_vecRHSettings.z
        / RH_RADIANCE_SAMPLE_COUNT;

    [loop]
    for ( int sampleIndex = 0; sampleIndex < RH_RADIANCE_SAMPLE_COUNT; ++sampleIndex )
        RH_AccumulateRadiance( centerUV, RH_GetSymmetricRSMOffset( sampleIndex ), cellCenterWS,
            sampleProjectedArea, shR, shG, shB, confidenceSum, nearestDistanceCells );

    Out.vSH_R = RH_LimitRadianceSH( shR );
    Out.vSH_G = RH_LimitRadianceSH( shG );
    Out.vSH_B = RH_LimitRadianceSH( shB );
    float valid = step( 1.0e-5f, confidenceSum );
    float gatherCells = max( g_vecRHSettings.z / max( g_vecRHSettings.y, 1.0f ), 1.0f );
    float normalizedEnergy = saturate(
        RH_RadianceEnergy( Out.vSH_R, Out.vSH_G, Out.vSH_B )
        / max( g_vecRHQuality.y, 0.25f ) );
    Out.vMeta = float4(
        saturate( confidenceSum / RH_RADIANCE_SAMPLE_COUNT ),
        valid * saturate( nearestDistanceCells / gatherCells ) + ( 1.0f - valid ),
        normalizedEnergy,
        valid );
#else
    float skyEnabled = saturate( g_vecRHSkyUpper.w );
    float skyIntensity = max( g_vecRHSkyLower.w, 0.0f ) * skyEnabled;
    float3 upperSky = max( g_vecRHSkyUpper.rgb, 0.0f ) * skyIntensity;
    float3 lowerSky = max( g_vecRHSkyLower.rgb, 0.0f ) * skyIntensity;
    float4 shR = 0.0f;
    float4 shG = 0.0f;
    float4 shB = 0.0f;
    RH_AccumulateHemisphereSky( In.vVolumeUVW, 1.0f, upperSky, shR, shG, shB );
    RH_AccumulateHemisphereSky( In.vVolumeUVW,-1.0f, lowerSky, shR, shG, shB );

    Out.vSH_R = RH_LimitRadianceSH( shR );
    Out.vSH_G = RH_LimitRadianceSH( shG );
    Out.vSH_B = RH_LimitRadianceSH( shB );
    float skyEnergy = RH_RadianceEnergy( Out.vSH_R, Out.vSH_G, Out.vSH_B );
    float valid = step( 1.0e-5f, skyEnergy );
    Out.vMeta = float4(
        saturate( skyEnergy / max( g_vecRHQuality.y, 0.25f ) ),
        1.0f,
        saturate( skyEnergy / max( g_vecRHQuality.y, 0.25f ) ),
        valid );
#endif
    return Out;
}
