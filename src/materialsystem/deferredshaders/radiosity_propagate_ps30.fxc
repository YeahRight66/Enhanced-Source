// STATIC: "BOUNCE_MODE" "0..6"
// 0 = true surface bounce generation.
// 1..3 = physical X/Y/Z transport of the surface bounce.
// 4..6 = low-energy Jason-style X/Y/Z RH diffusion from the first-bounce field.

#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"
#include "radiance_hints_common_fxc.h"

sampler sSH_R          : register( s0 );
sampler sSH_G          : register( s1 );
sampler sSH_B          : register( s2 );
sampler sVisibility    : register( s3 );
sampler sMeta          : register( s4 );
sampler sGeometry      : register( s5 );
sampler sGeometryDist  : register( s6 );
sampler sSurfaceAlbedo : register( s7 );
sampler sSurfaceNormal : register( s8 );
sampler sShadowDist    : register( s9 );
sampler sSurfaceGuide  : register( s10 );
sampler sShadowGeometry: register( s11 );

// x = physical sample radius UV, y = physical transport gain,
// z = max radiance, w = physical radius cells.
const float4 g_vecRHBounceSettings : register( c0 );
// x = visibility enable, y = extinction, z = min transmittance, w = blocker bias.
const float4 g_vecRHVisibilitySettings : register( c1 );
// xyz = RH origin, w = cell size.
const float4 g_vecRHWorldGrid : register( c2 );
// x = trace cone width cells, y = physical minimum confidence,
// z = bounce mode, w = surface-bounce generation gain.
const float4 g_vecRHTraceSettings : register( c3 );
// x = minimum surface coverage.
const float4 g_vecRHSurfaceSettings : register( c4 );
// x = diffusion gain, y = diffusion radius UV,
// z = diffusion radius cells, w = diffusion minimum confidence.
const float4 g_vecRHDiffusionSettings : register( c5 );
// x surface-cache enable, y guide-normal blend, z fallback albedo, w reserved.
const float4 g_vecRHSurfaceGuideSettings : register( c6 );
// x adaptive diffusion enable, y near radius cells, z far radius cells, w reserved.
const float4 g_vecRHAdaptiveDiffusion : register( c7 );

struct PS_INPUT
{
    float3 vVolumeUVW : TEXCOORD0;
    float2 vAtlasUV   : TEXCOORD1;
};

struct PS_OUTPUT
{
    float4 vSH_R : COLOR0;
    float4 vSH_G : COLOR1;
    float4 vSH_B : COLOR2;
};

#if BOUNCE_MODE != 0
float RH_TransferVisibilityCompact(
    float3 sourceUVW,
    float3 destinationUVW,
    float3 travelDirection,
    float radiusCells )
{
    float3 midpoint = lerp( sourceUVW, destinationUVW, 0.5f );
    float directionalBlocker = RH_EvaluateVisibilityTwoSided(
        RH_SampleAtlas( sVisibility, midpoint ), travelDirection );
    float staticBlocker = max( RH_SampleAtlas( sGeometry, midpoint ).r,
        RH_SampleShadowAtlas( sShadowGeometry, midpoint ).r );
    float shadowDistanceCells = RH_ShadowDistanceCells( sShadowDist, midpoint );
    float distanceCells = shadowDistanceCells * ( RH_VOLUME_SIZE_F / RH_SHADOW_VOLUME_SIZE_F );
    float clearance = saturate( distanceCells / max( radiusCells, 1.0f ) );
    float opticalDepth = max( directionalBlocker, staticBlocker )
        * lerp( 0.68f, 0.36f, clearance );

    float bias = clamp( g_vecRHVisibilitySettings.w, 0.0f, 0.95f );
    opticalDepth = max( opticalDepth - bias, 0.0f ) / max( 1.0f - bias, 0.05f );
    float transmittance = exp2(
        -4.0f * max( g_vecRHVisibilitySettings.y, 0.0f ) * opticalDepth );
    transmittance = max( transmittance, saturate( g_vecRHVisibilitySettings.z ) );
    return lerp( 1.0f, transmittance, saturate( g_vecRHVisibilitySettings.x ) );
}
#endif

#if BOUNCE_MODE >= 1 && BOUNCE_MODE <= 3
#define RH_ACCUMULATE_TRANSPORT( DX, DY, DZ ) \
{ \
    float3 rhSourceDirection = float3( DX, DY, DZ ); \
    float3 rhSourceUVW = In.vVolumeUVW + rhSourceDirection * g_vecRHBounceSettings.x; \
    float rhInside = RH_InsideVolume( rhSourceUVW ); \
    float4 rhMeta = RH_SampleAtlas( sMeta, rhSourceUVW ); \
    float rhConfidence = RH_MetaConfidence( rhMeta ); \
    float4 rhR = RH_LimitRadianceSH( RH_SampleAtlas( sSH_R, rhSourceUVW ) ); \
    float4 rhG = RH_LimitRadianceSH( RH_SampleAtlas( sSH_G, rhSourceUVW ) ); \
    float4 rhB = RH_LimitRadianceSH( RH_SampleAtlas( sSH_B, rhSourceUVW ) ); \
    float rhEnergy = RH_RadianceEnergy( rhR, rhG, rhB ); \
    float rhConfidenceValid = step( saturate( g_vecRHTraceSettings.y ), max( rhConfidence, saturate( rhEnergy ) ) ); \
    float rhValid = rhInside * rhConfidenceValid * step( 1.0e-5f, rhEnergy ); \
    float3 rhTravelDirection = -rhSourceDirection; \
    float rhVisibility = RH_TransferVisibilityCompact( rhSourceUVW, In.vVolumeUVW, rhTravelDirection, g_vecRHBounceSettings.w ); \
    float rhWeight = rhValid * rhVisibility / ( 1.0f + 0.45f * g_vecRHBounceSettings.w * g_vecRHBounceSettings.w ); \
    float4 rhBasis = RH_ProjectDirection( rhTravelDirection ); \
    float rhMaximum = max( g_vecRHBounceSettings.z, 0.25f ); \
    bouncedSH_R += rhBasis * ( min( max( dot( rhR, rhBasis ), 0.0f ), rhMaximum ) * rhWeight ); \
    bouncedSH_G += rhBasis * ( min( max( dot( rhG, rhBasis ), 0.0f ), rhMaximum ) * rhWeight ); \
    bouncedSH_B += rhBasis * ( min( max( dot( rhB, rhBasis ), 0.0f ), rhMaximum ) * rhWeight ); \
}
#endif

#if BOUNCE_MODE >= 4
// Jason-inspired diffusion: sample nearby first-bounce RH, use the stored
// confidence plus our geometry-distance/visibility field as the visibility
// test, then reproject only a small amount in the travel direction. Pairwise
// +/- directions retain reflection symmetry and contain no temporal noise.
#define RH_ACCUMULATE_DIFFUSION( DX, DY, DZ ) \
{ \
    float3 rhSourceDirection = float3( DX, DY, DZ ); \
    float3 rhSourceUVW = In.vVolumeUVW + rhSourceDirection * diffusionRadiusUVLocal; \
    float rhInside = RH_InsideVolume( rhSourceUVW ); \
    float4 rhMeta = RH_SampleAtlas( sMeta, rhSourceUVW ); \
    float rhConfidence = RH_MetaConfidence( rhMeta ); \
    float4 rhR = RH_LimitRadianceSH( RH_SampleAtlas( sSH_R, rhSourceUVW ) ); \
    float4 rhG = RH_LimitRadianceSH( RH_SampleAtlas( sSH_G, rhSourceUVW ) ); \
    float4 rhB = RH_LimitRadianceSH( RH_SampleAtlas( sSH_B, rhSourceUVW ) ); \
    float rhEnergy = RH_RadianceEnergy( rhR, rhG, rhB ); \
    float rhConfidenceValid = step( saturate( g_vecRHDiffusionSettings.w ), max( rhConfidence, saturate( rhEnergy ) ) ); \
    float rhValid = rhInside * rhConfidenceValid * step( 1.0e-5f, rhEnergy ); \
    float3 rhTravelDirection = -rhSourceDirection; \
    float rhVisibility = RH_TransferVisibilityCompact( rhSourceUVW, In.vVolumeUVW, rhTravelDirection, diffusionRadiusCellsLocal ); \
    float rhSourceDistanceCells = RH_ShadowDistanceCells( sShadowDist, rhSourceUVW ) * ( RH_VOLUME_SIZE_F / RH_SHADOW_VOLUME_SIZE_F ); \
    float rhClearance = saturate( rhSourceDistanceCells / max( diffusionRadiusCellsLocal, 1.0f ) ); \
    float rhWeight = rhValid * rhVisibility * lerp( 0.42f, 1.0f, rhClearance ) \
        / ( 1.0f + 0.28f * diffusionRadiusCellsLocal * diffusionRadiusCellsLocal ); \
    float4 rhBasis = RH_ProjectDirection( rhTravelDirection ); \
    float rhMaximum = max( g_vecRHBounceSettings.z, 0.25f ); \
    diffusedSH_R += rhBasis * ( min( max( dot( rhR, rhBasis ), 0.0f ), rhMaximum ) * rhWeight ); \
    diffusedSH_G += rhBasis * ( min( max( dot( rhG, rhBasis ), 0.0f ), rhMaximum ) * rhWeight ); \
    diffusedSH_B += rhBasis * ( min( max( dot( rhB, rhBasis ), 0.0f ), rhMaximum ) * rhWeight ); \
}
#endif

PS_OUTPUT main( const PS_INPUT In )
{
    PS_OUTPUT Out;

#if BOUNCE_MODE == 0
    // True surface bounce: first-bounce + hemisphere irradiance is reflected by
    // RSM material albedo and re-emitted into the outward Lambertian hemisphere.
    float4 surfaceAlbedoAccum = RH_SampleAtlas( sSurfaceAlbedo, In.vVolumeUVW );
    float4 surfaceNormalAccum = RH_SampleAtlas( sSurfaceNormal, In.vVolumeUVW );
    float4 guide = RH_SampleAtlas( sSurfaceGuide, In.vVolumeUVW );
    float guideCoverage = saturate( guide.a ) * saturate( g_vecRHSurfaceGuideSettings.x );
    float3 guideNormal = RH_DecodeSurfaceGuideNormal( guide );
    float weight = min( surfaceAlbedoAccum.a, surfaceNormalAccum.a );
    float rsmValid = step( max( g_vecRHSurfaceSettings.x, 0.0f ), weight );
    float inverseWeight = 1.0f / max( weight, 1.0e-4f );
    float3 rsmAlbedo = saturate( surfaceAlbedoAccum.rgb * inverseWeight );
    float3 averagedNormal = surfaceNormalAccum.rgb * inverseWeight;
    float normalCoherence = saturate( length( averagedNormal ) );
    rsmValid *= smoothstep( 0.20f, 0.55f, normalCoherence );
    float guideValid = step( 0.08f, guideCoverage );
    float valid = saturate( max( rsmValid, guideValid ) );
    float fallbackAlbedo = saturate( g_vecRHSurfaceGuideSettings.z );
    float3 albedo = lerp( fallbackAlbedo.xxx, rsmAlbedo, rsmValid );
    float3 rsmNormal = RH_SafeNormalize( averagedNormal, guideNormal );
    float repair = guideValid * saturate( g_vecRHSurfaceGuideSettings.y ) * ( 1.0f - normalCoherence * 0.55f );
    float3 normal = RH_SafeNormalize( lerp( rsmNormal, guideNormal, repair ), guideNormal );

    float4 diffuseBasis = RH_DiffuseBasis( -normal );
    float3 irradiance;
    irradiance.r = max( dot( RH_SampleAtlas( sSH_R, In.vVolumeUVW ), diffuseBasis ), 0.0f );
    irradiance.g = max( dot( RH_SampleAtlas( sSH_G, In.vVolumeUVW ), diffuseBasis ), 0.0f );
    irradiance.b = max( dot( RH_SampleAtlas( sSH_B, In.vVolumeUVW ), diffuseBasis ), 0.0f );

    float3 reflectedRadiance = albedo * irradiance
        * ( 0.3183098862f * max( g_vecRHTraceSettings.w, 0.0f ) * valid );
    reflectedRadiance = RH_ClampRadiance(
        reflectedRadiance, max( g_vecRHBounceSettings.z, 0.25f ) );
    float4 hemisphereBasis = RH_ProjectHemisphere( normal );
    Out.vSH_R = RH_LimitRadianceSH( hemisphereBasis * reflectedRadiance.r );
    Out.vSH_G = RH_LimitRadianceSH( hemisphereBasis * reflectedRadiance.g );
    Out.vSH_B = RH_LimitRadianceSH( hemisphereBasis * reflectedRadiance.b );
#elif BOUNCE_MODE <= 3
    float4 bouncedSH_R = 0.0f;
    float4 bouncedSH_G = 0.0f;
    float4 bouncedSH_B = 0.0f;

#if BOUNCE_MODE == 1
    RH_ACCUMULATE_TRANSPORT( 1.0f, 0.0f, 0.0f );
    RH_ACCUMULATE_TRANSPORT(-1.0f, 0.0f, 0.0f );
#elif BOUNCE_MODE == 2
    RH_ACCUMULATE_TRANSPORT( 0.0f, 1.0f, 0.0f );
    RH_ACCUMULATE_TRANSPORT( 0.0f,-1.0f, 0.0f );
#else
    RH_ACCUMULATE_TRANSPORT( 0.0f, 0.0f, 1.0f );
    RH_ACCUMULATE_TRANSPORT( 0.0f, 0.0f,-1.0f );
#endif

    float normalization = max( g_vecRHBounceSettings.y, 0.0f ) / 6.0f;
    Out.vSH_R = RH_LimitRadianceSH( bouncedSH_R * normalization );
    Out.vSH_G = RH_LimitRadianceSH( bouncedSH_G * normalization );
    Out.vSH_B = RH_LimitRadianceSH( bouncedSH_B * normalization );
#else
    float destinationShadowDistance = RH_ShadowDistanceCells( sShadowDist, In.vVolumeUVW ) * ( RH_VOLUME_SIZE_F / RH_SHADOW_VOLUME_SIZE_F );
    float adaptiveT = saturate( destinationShadowDistance / 4.0f );
    float adaptiveRadius = lerp( max( g_vecRHAdaptiveDiffusion.y, 0.5f ), max( g_vecRHAdaptiveDiffusion.z, 0.5f ), adaptiveT );
    float diffusionRadiusCellsLocal = lerp( g_vecRHDiffusionSettings.z, adaptiveRadius, saturate( g_vecRHAdaptiveDiffusion.x ) );
    float diffusionRadiusUVLocal = diffusionRadiusCellsLocal / RH_VOLUME_SIZE_F;
    float4 diffusedSH_R = 0.0f;
    float4 diffusedSH_G = 0.0f;
    float4 diffusedSH_B = 0.0f;

#if BOUNCE_MODE == 4
    RH_ACCUMULATE_DIFFUSION( 1.0f, 0.0f, 0.0f );
    RH_ACCUMULATE_DIFFUSION(-1.0f, 0.0f, 0.0f );
#elif BOUNCE_MODE == 5
    RH_ACCUMULATE_DIFFUSION( 0.0f, 1.0f, 0.0f );
    RH_ACCUMULATE_DIFFUSION( 0.0f,-1.0f, 0.0f );
#else
    RH_ACCUMULATE_DIFFUSION( 0.0f, 0.0f, 1.0f );
    RH_ACCUMULATE_DIFFUSION( 0.0f, 0.0f,-1.0f );
#endif

    float normalization = max( g_vecRHDiffusionSettings.x, 0.0f ) / 6.0f;
    Out.vSH_R = RH_LimitRadianceSH( diffusedSH_R * normalization );
    Out.vSH_G = RH_LimitRadianceSH( diffusedSH_G * normalization );
    Out.vSH_B = RH_LimitRadianceSH( diffusedSH_B * normalization );
#endif
    return Out;
}
