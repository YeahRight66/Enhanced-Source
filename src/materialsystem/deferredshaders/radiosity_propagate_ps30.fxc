#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"
#include "radiance_hints_common_fxc.h"

sampler sSH_R       : register( s0 );
sampler sSH_G       : register( s1 );
sampler sSH_B       : register( s2 );
sampler sVisibility : register( s3 );
sampler sMeta       : register( s4 );

// x = sample radius UV, y = bounce gain, z = max radiance, w = radius cells.
const float4 g_vecRHBounceSettings : register( c0 );
// x = visibility enable, y = extinction, z = min transmittance, w = blocker bias.
const float4 g_vecRHVisibilitySettings : register( c1 );
// xyz = RH origin, w = cell size.
const float4 g_vecRHWorldGrid : register( c2 );
// x = trace cone width in cells, y = minimum confidence.
const float4 g_vecRHTraceSettings : register( c3 );

struct PS_INPUT
{
    float3 vVolumeUVW : TEXCOORD0;
    float2 vAtlasUV   : TEXCOORD1;
};

struct PS_OUTPUT
{
    float4 vSH_R : COLOR0;
    float4 vSH_G : COLOR1;
    float4 vSH_B : COLOR2;
};

float3 RH_RotateDirectionZ( float3 direction, float sineValue, float cosineValue )
{
    float2 rotatedXY = RH_Rotate2D( direction.xy, sineValue, cosineValue );
    return float3( rotatedXY, direction.z );
}

float3 RH_TraceTangent( float3 direction )
{
    float3 referenceAxis = abs( direction.z ) < 0.85f
        ? float3( 0.0f, 0.0f, 1.0f )
        : float3( 0.0f, 1.0f, 0.0f );
    return RH_SafeNormalize( cross( referenceAxis, direction ), float3( 1.0f, 0.0f, 0.0f ) );
}

float RH_TransferVisibility( float3 sourceUVW, float3 destinationUVW, float3 travelDirection )
{
    float blocker = 0.0f;
    float3 tangent = RH_TraceTangent( travelDirection );
    float coneUV = max( g_vecRHTraceSettings.x, 0.0f ) / RH_VOLUME_SIZE_F;

#if RH_GEOMETRY_TRACE_TAP_COUNT >= 1
    float3 traceUVW0 = lerp( sourceUVW, destinationUVW, 0.36f );
    float3 traceSide0 = traceUVW0 + tangent * ( coneUV * 0.35f );
    float blocker0 = RH_EvaluateVisibilityTwoSided( RH_SampleAtlas( sVisibility, traceUVW0 ), travelDirection );
    float blockerSide0 = RH_EvaluateVisibilityTwoSided( RH_SampleAtlas( sVisibility, traceSide0 ), travelDirection );
    blocker = max( blocker, max( blocker0, blockerSide0 ) * RH_InsideVolume( traceUVW0 ) );
#endif
#if RH_GEOMETRY_TRACE_TAP_COUNT >= 2
    float3 traceUVW1 = lerp( sourceUVW, destinationUVW, 0.70f );
    float3 traceSide1 = traceUVW1 - tangent * ( coneUV * 0.70f );
    float blocker1 = RH_EvaluateVisibilityTwoSided( RH_SampleAtlas( sVisibility, traceUVW1 ), travelDirection );
    float blockerSide1 = RH_EvaluateVisibilityTwoSided( RH_SampleAtlas( sVisibility, traceSide1 ), travelDirection );
    blocker = max( blocker, max( blocker1, blockerSide1 ) * RH_InsideVolume( traceUVW1 ) );
#endif

    float bias = clamp( g_vecRHVisibilitySettings.w, 0.0f, 0.95f );
    blocker = saturate( ( blocker - bias ) / max( 1.0f - bias, 0.05f ) );
    float transmittance = exp2( -4.0f * max( g_vecRHVisibilitySettings.y, 0.0f ) * blocker );
    transmittance = max( transmittance, saturate( g_vecRHVisibilitySettings.z ) );
    return lerp( 1.0f, transmittance, saturate( g_vecRHVisibilitySettings.x ) );
}

void RH_AccumulateBounce(
    float3 destinationUVW,
    float3 sourceDirection,
    inout float4 outSH_R,
    inout float4 outSH_G,
    inout float4 outSH_B,
    inout float totalWeight )
{
    float3 sourceUVW = destinationUVW + sourceDirection * g_vecRHBounceSettings.x;
    float inside = RH_InsideVolume( sourceUVW );
    float4 sourceMeta = RH_SampleAtlas( sMeta, sourceUVW );
    float sourceConfidence = max( RH_MetaConfidence( sourceMeta ), saturate( g_vecRHTraceSettings.y ) );
    float valid = inside * saturate( sourceMeta.w ) * step( 1.0e-5f, sourceMeta.z );

    float3 travelDirection = RH_SafeNormalize( -sourceDirection, float3( 0.0f, 0.0f, 1.0f ) );
    float visibility = RH_TransferVisibility( sourceUVW, destinationUVW, travelDirection );
    float weight = valid * sourceConfidence * visibility
        / ( 1.0f + 0.45f * g_vecRHBounceSettings.w * g_vecRHBounceSettings.w );
    float4 transferBasis = RH_ProjectDirection( travelDirection );
    float maximumRadiance = max( g_vecRHBounceSettings.z, 0.25f );

    // Evaluate and accumulate one colour channel at a time to keep temporary
    // register usage compatible with ps_3_0 even in the six-direction preset.
    {
        float4 sourceSH = RH_LimitRadianceSH( RH_SampleAtlas( sSH_R, sourceUVW ) );
        float transported = min( max( dot( sourceSH, transferBasis ), 0.0f ), maximumRadiance );
        outSH_R += transferBasis * ( transported * weight );
    }
    {
        float4 sourceSH = RH_LimitRadianceSH( RH_SampleAtlas( sSH_G, sourceUVW ) );
        float transported = min( max( dot( sourceSH, transferBasis ), 0.0f ), maximumRadiance );
        outSH_G += transferBasis * ( transported * weight );
    }
    {
        float4 sourceSH = RH_LimitRadianceSH( RH_SampleAtlas( sSH_B, sourceUVW ) );
        float transported = min( max( dot( sourceSH, transferBasis ), 0.0f ), maximumRadiance );
        outSH_B += transferBasis * ( transported * weight );
    }
    totalWeight += weight;
}

PS_OUTPUT main( const PS_INPUT In )
{
    PS_OUTPUT Out;

    float3 cellCenterWS = g_vecRHWorldGrid.xyz
        + In.vVolumeUVW * ( g_vecRHWorldGrid.w * RH_VOLUME_SIZE_F );
    float3 worldCell = floor( cellCenterWS / max( g_vecRHWorldGrid.w, 1.0f ) );
    float quadrant = floor( RH_Hash13( worldCell + float3( 97.0f, 29.0f, 53.0f ) ) * 4.0f );
    float rotationSine = 0.0f;
    float rotationCosine = 1.0f;
    if ( quadrant < 1.0f ) { rotationSine = 0.0f;  rotationCosine = 1.0f; }
    else if ( quadrant < 2.0f ) { rotationSine = 1.0f;  rotationCosine = 0.0f; }
    else if ( quadrant < 3.0f ) { rotationSine = 0.0f;  rotationCosine = -1.0f; }
    else { rotationSine = -1.0f; rotationCosine = 0.0f; }

    float4 bouncedSH_R = 0.0f;
    float4 bouncedSH_G = 0.0f;
    float4 bouncedSH_B = 0.0f;
    float totalWeight = 0.0f;

#if RH_BOUNCE_SAMPLE_COUNT == 4
    RH_AccumulateBounce( In.vVolumeUVW,
        RH_RotateDirectionZ( float3( 0.5773503f,  0.5773503f,  0.5773503f ), rotationSine, rotationCosine ),
        bouncedSH_R, bouncedSH_G, bouncedSH_B, totalWeight );
    RH_AccumulateBounce( In.vVolumeUVW,
        RH_RotateDirectionZ( float3(-0.5773503f, -0.5773503f,  0.5773503f ), rotationSine, rotationCosine ),
        bouncedSH_R, bouncedSH_G, bouncedSH_B, totalWeight );
    RH_AccumulateBounce( In.vVolumeUVW,
        RH_RotateDirectionZ( float3(-0.5773503f,  0.5773503f, -0.5773503f ), rotationSine, rotationCosine ),
        bouncedSH_R, bouncedSH_G, bouncedSH_B, totalWeight );
    RH_AccumulateBounce( In.vVolumeUVW,
        RH_RotateDirectionZ( float3( 0.5773503f, -0.5773503f, -0.5773503f ), rotationSine, rotationCosine ),
        bouncedSH_R, bouncedSH_G, bouncedSH_B, totalWeight );
#else
    RH_AccumulateBounce( In.vVolumeUVW, RH_RotateDirectionZ( float3( 1.0f, 0.0f, 0.0f ), rotationSine, rotationCosine ), bouncedSH_R, bouncedSH_G, bouncedSH_B, totalWeight );
    RH_AccumulateBounce( In.vVolumeUVW, RH_RotateDirectionZ( float3(-1.0f, 0.0f, 0.0f ), rotationSine, rotationCosine ), bouncedSH_R, bouncedSH_G, bouncedSH_B, totalWeight );
    RH_AccumulateBounce( In.vVolumeUVW, RH_RotateDirectionZ( float3( 0.0f, 1.0f, 0.0f ), rotationSine, rotationCosine ), bouncedSH_R, bouncedSH_G, bouncedSH_B, totalWeight );
    RH_AccumulateBounce( In.vVolumeUVW, RH_RotateDirectionZ( float3( 0.0f,-1.0f, 0.0f ), rotationSine, rotationCosine ), bouncedSH_R, bouncedSH_G, bouncedSH_B, totalWeight );
    RH_AccumulateBounce( In.vVolumeUVW, float3( 0.0f, 0.0f, 1.0f ), bouncedSH_R, bouncedSH_G, bouncedSH_B, totalWeight );
    RH_AccumulateBounce( In.vVolumeUVW, float3( 0.0f, 0.0f,-1.0f ), bouncedSH_R, bouncedSH_G, bouncedSH_B, totalWeight );
#endif

    float normalization = g_vecRHBounceSettings.y / max( totalWeight, 1.0f );
    Out.vSH_R = RH_LimitRadianceSH( bouncedSH_R * normalization );
    Out.vSH_G = RH_LimitRadianceSH( bouncedSH_G * normalization );
    Out.vSH_B = RH_LimitRadianceSH( bouncedSH_B * normalization );
    return Out;
}
