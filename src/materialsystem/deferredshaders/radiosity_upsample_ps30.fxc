#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"
#include "radiance_hints_config.h"

sampler sHalfGI  : register( s0 );
sampler sDepth   : register( s1 );
sampler sNormals : register( s2 );

// xy half dimensions, zw inverse dimensions.
const float4 g_HalfSize : register( c0 );
// x depth rejection scale, y normal exponent, z fallback depth scale.
const float4 g_Filter   : register( c1 );

struct PS_INPUT { float2 vTexCoord : TEXCOORD0; };

float3 DecodeRHNormal( float2 uv )
{
    float3 normal = DecodeDirectionVectorXYZFromSphericalST(
        tex2Dlod( sNormals, float4( uv, 0.0f, 0.0f ) ).xy );
    return normal * rsqrt( max( dot( normal, normal ), 1.0e-8f ) );
}

void AccumulateRH(
    float2 uv, float spatialWeight, float centerDepth, float3 centerNormal,
    inout float3 colourSum, inout float weightSum,
    inout float3 fallbackColour, inout float fallbackError )
{
    uv = saturate( uv );
    float4 gi = tex2Dlod( sHalfGI, float4( uv, 0.0f, 0.0f ) );
    float valid = step( 0.1f, gi.a ) * step( gi.a, DEPTH_RECONSTRUCTION_LIMIT );
    float depthDifference = abs( gi.a - centerDepth );
    float depthWeight = exp2( -depthDifference * g_Filter.x );
    float normalWeight = pow( saturate( dot( centerNormal, DecodeRHNormal( uv ) ) ), g_Filter.y );
    float weight = spatialWeight * depthWeight * normalWeight * valid;
    colourSum += gi.rgb * weight;
    weightSum += weight;

    float error = depthDifference + ( 1.0f - normalWeight ) * max( g_Filter.z, 0.0f )
        + ( 1.0f - valid ) * 65504.0f;
    float replaceFallback = step( error, fallbackError );
    fallbackColour = lerp( fallbackColour, gi.rgb, replaceFallback );
    fallbackError = lerp( fallbackError, error, replaceFallback );
}

float4 main( const PS_INPUT In ) : COLOR0
{
    float centerDepth = tex2D( sDepth, In.vTexCoord ).x;
    clip( min( centerDepth - 0.1f, DEPTH_RECONSTRUCTION_LIMIT - centerDepth ) );
    float3 centerNormal = DecodeRHNormal( In.vTexCoord );

    // Convert the full-resolution sample to continuous half-resolution pixel
    // space. This preserves the real subpixel phase instead of snapping every
    // 2x2 full-resolution block to one half-resolution texel.
    float2 halfPosition = In.vTexCoord * g_HalfSize.xy - 0.5f;
    float2 basePixel = floor( halfPosition );
    float2 fractionValue = frac( halfPosition );
    float2 uv00 = ( basePixel + 0.5f ) * g_HalfSize.zw;
    float2 uv10 = uv00 + float2( g_HalfSize.z, 0.0f );
    float2 uv01 = uv00 + float2( 0.0f, g_HalfSize.w );
    float2 uv11 = uv00 + g_HalfSize.zw;

    float4 spatial = float4(
        ( 1.0f - fractionValue.x ) * ( 1.0f - fractionValue.y ),
        fractionValue.x * ( 1.0f - fractionValue.y ),
        ( 1.0f - fractionValue.x ) * fractionValue.y,
        fractionValue.x * fractionValue.y );

    float3 sum = 0.0f;
    float weight = 0.0f;
    float3 fallbackColour = 0.0f;
    float fallbackError = 65504.0f;

    AccumulateRH( uv00, spatial.x, centerDepth, centerNormal, sum, weight, fallbackColour, fallbackError );
    AccumulateRH( uv10, spatial.y, centerDepth, centerNormal, sum, weight, fallbackColour, fallbackError );
    AccumulateRH( uv01, spatial.z, centerDepth, centerNormal, sum, weight, fallbackColour, fallbackError );
    AccumulateRH( uv11, spatial.w, centerDepth, centerNormal, sum, weight, fallbackColour, fallbackError );

    float validWeight = step( 1.0e-5f, weight );
    float3 filtered = sum / max( weight, 1.0e-5f );
    filtered = lerp( fallbackColour, filtered, validWeight );
    return WriteLighting( float4( filtered, 0.0f ) );
}
