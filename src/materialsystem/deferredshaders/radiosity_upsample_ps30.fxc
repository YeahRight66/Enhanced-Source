#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"
#include "radiance_hints_config.h"

sampler sHalfGI  : register( s0 );
sampler sDepth   : register( s1 );
sampler sNormals : register( s2 );

// xy half dimensions, zw inverse dimensions
const float4 g_HalfSize : register( c0 );
// x depth rejection scale, y normal exponent, z spatial falloff
const float4 g_Filter   : register( c1 );

struct PS_INPUT { float2 vTexCoord : TEXCOORD0; };

float3 DecodeRHNormal( float2 uv )
{
    float3 normal = DecodeDirectionVectorXYZFromSphericalST(
        tex2Dlod( sNormals, float4( uv, 0.0f, 0.0f ) ).xy );
    float lengthSquared = dot( normal, normal );
    return normal * rsqrt( max( lengthSquared, 1.0e-8f ) );
}

void AccumulateRH(
    float2 uv, float spatialWeight, float centerDepth, float3 centerNormal,
    inout float3 colourSum, inout float weightSum )
{
    float4 gi = tex2Dlod( sHalfGI, float4( uv, 0.0f, 0.0f ) );
    float valid = step( 0.1f, gi.a ) * step( gi.a, DEPTH_RECONSTRUCTION_LIMIT );
    float depthWeight = exp2( -abs( gi.a - centerDepth ) * g_Filter.x );
    float normalWeight = pow( saturate( dot( centerNormal, DecodeRHNormal( uv ) ) ), g_Filter.y );
    float weight = spatialWeight * depthWeight * normalWeight * valid;
    colourSum += gi.rgb * weight;
    weightSum += weight;
}

float4 main( const PS_INPUT In ) : COLOR0
{
    float centerDepth = tex2D( sDepth, In.vTexCoord ).x;
    clip( min( centerDepth - 0.1f, DEPTH_RECONSTRUCTION_LIMIT - centerDepth ) );
    float3 centerNormal = DecodeRHNormal( In.vTexCoord );

    float2 nearestPixel = floor( In.vTexCoord * g_HalfSize.xy );
    float2 invSize = g_HalfSize.zw;
    float2 centerUV = ( nearestPixel + 0.5f ) * invSize;

    float3 sum = 0.0f;
    float weight = 0.0f;

    AccumulateRH( centerUV, 1.0f, centerDepth, centerNormal, sum, weight );
    AccumulateRH( centerUV + float2( invSize.x, 0.0f ), 0.72f, centerDepth, centerNormal, sum, weight );
    AccumulateRH( centerUV - float2( invSize.x, 0.0f ), 0.72f, centerDepth, centerNormal, sum, weight );
    AccumulateRH( centerUV + float2( 0.0f, invSize.y ), 0.72f, centerDepth, centerNormal, sum, weight );
    AccumulateRH( centerUV - float2( 0.0f, invSize.y ), 0.72f, centerDepth, centerNormal, sum, weight );

#if RH_UPSAMPLE_TAP_COUNT >= 9
    AccumulateRH( centerUV + float2( invSize.x, invSize.y ), 0.48f, centerDepth, centerNormal, sum, weight );
    AccumulateRH( centerUV + float2(-invSize.x, invSize.y ), 0.48f, centerDepth, centerNormal, sum, weight );
    AccumulateRH( centerUV + float2( invSize.x,-invSize.y ), 0.48f, centerDepth, centerNormal, sum, weight );
    AccumulateRH( centerUV - float2( invSize.x, invSize.y ), 0.48f, centerDepth, centerNormal, sum, weight );
#endif

    float3 nearestGI = tex2Dlod( sHalfGI, float4( centerUV, 0.0f, 0.0f ) ).rgb;
    float validWeight = step( 1.0e-5f, weight );
    float3 filtered = sum / max( weight, 1.0e-5f );
    filtered = lerp( nearestGI, filtered, validWeight );
    return WriteLighting( float4( filtered, 0.0f ) );
}
