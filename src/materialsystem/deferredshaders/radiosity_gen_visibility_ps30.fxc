#include "common_ps_fxc.h"
#include "radiance_hints_common_fxc.h"

const float4x4 g_matWorldToRSM : register( c0 );
const float4x4 g_matRSMToWorld : register( c4 );
const float3   g_vecGridOrigin : register( c8 );

// x = volume extent, y = cell size, z = edge fade, w = RSM world side
const float4 g_vecRHSettings : register( c9 );

// x = enable, y = inner radius cells, z = outer radius cells, w = strength
const float4 g_vecVisibility : register( c10 );

// x = distance decay, y = inverse RSM resolution,
// z = dilation cells, w = normal-facing influence
const float4 g_vecDecay : register( c11 );

// x = per-view accumulation scale (0.5 for front/back dual capture)
const float4 g_vecPass : register( c12 );

sampler sRSMDepth  : register( s0 );
sampler sRSMNormal : register( s1 );

struct PS_INPUT
{
    float3 vVolumeUVW : TEXCOORD0;
    float2 vAtlasUV   : TEXCOORD1;
};

float3 RH_ReconstructRSMPositionVisibility( float2 uv, float depth )
{
    float4 world = mul( float4( uv, depth, 1.0f ), g_matRSMToWorld );
    return world.xyz / max( abs( world.w ), 1.0e-6f );
}

// Kept as a function rather than an indexed constant array because old DX9
// FXC is more reliable with integer flow control than relative addressing
// into locally initialized arrays.
float2 RH_GetVisibilityOffset( int sampleIndex )
{
    if ( sampleIndex == 0 ) return float2( 0.000f,  0.000f );
    if ( sampleIndex == 1 ) return float2( 0.650f,  0.150f );
    if ( sampleIndex == 2 ) return float2(-0.450f,  0.550f );
    if ( sampleIndex == 3 ) return float2( 0.100f, -0.700f );
    if ( sampleIndex == 4 ) return float2(-0.750f, -0.250f );
    return float2( 0.700f, -0.550f );
}

float4 main( const PS_INPUT In ) : COLOR0
{
    const float cellSize = max( g_vecRHSettings.y, 1.0f );
    const float inverseRSMWorldSide = 1.0f / max( g_vecRHSettings.w, 1.0f );

    float3 cellCenterWS =
        g_vecGridOrigin + In.vVolumeUVW * g_vecRHSettings.x;

    float4 projected =
        mul( float4( cellCenterWS, 1.0f ), g_matWorldToRSM );

    float2 centerUV =
        projected.xy / max( abs( projected.w ), 1.0e-6f );

    float3 worldCell = floor( cellCenterWS / cellSize );
    float quadrant =
        floor( RH_Hash13(
            worldCell + float3( 61.0f, 17.0f, 43.0f ) ) * 4.0f );

    // x = sine, y = cosine
    float2 patternSinCos = float2( 0.0f, 1.0f );

    if ( quadrant < 1.0f )
        patternSinCos = float2( 0.0f,  1.0f );
    else if ( quadrant < 2.0f )
        patternSinCos = float2( 1.0f,  0.0f );
    else if ( quadrant < 3.0f )
        patternSinCos = float2( 0.0f, -1.0f );
    else
        patternSinCos = float2(-1.0f,  0.0f );

    const float footprintCells =
        g_vecRHSettings.w * g_vecDecay.y / cellSize;

    const float outerRadius =
        max(
            g_vecVisibility.z + g_vecDecay.z + footprintCells,
            g_vecVisibility.y + 0.01f );

    const float sampleUVScale =
        cellSize * max( outerRadius, 1.0f ) * inverseRSMWorldSide;

    const float visibilityEnable = saturate( g_vecVisibility.x );
    const float visibilityStrength = max( g_vecVisibility.w, 0.0f );
    const float distanceDecay = max( g_vecDecay.x, 0.0f );
    const float normalInfluence = saturate( g_vecDecay.w );

    float4 visibilitySH = 0.0f;
    float validWeight = 0.0f;

    // Critical for the legacy ps_3_0 compiler: keep one loop body and reuse
    // temporaries. The previous six compile-time-expanded helper calls could
    // make shadercompile.exe silently drop this shader.
    [loop]
    for ( int sampleIndex = 0;
          sampleIndex < RH_VISIBILITY_SAMPLE_COUNT;
          ++sampleIndex )
    {
        float2 diskOffset = RH_GetVisibilityOffset( sampleIndex );

        diskOffset = RH_Rotate2D(
            diskOffset,
            patternSinCos.x,
            patternSinCos.y );

        float2 uv = centerUV + diskOffset * sampleUVScale;

        float inside =
            step( 0.0f, uv.x ) * step( uv.x, 1.0f ) *
            step( 0.0f, uv.y ) * step( uv.y, 1.0f );

        uv = saturate( uv );

        float edge =
            min(
                min( uv.x, uv.y ),
                min( 1.0f - uv.x, 1.0f - uv.y ) );

        edge =
            saturate(
                edge / max( g_vecRHSettings.z, 1.0e-4f ) );

        edge = edge * edge * ( 3.0f - 2.0f * edge );

        float depth =
            tex2Dlod(
                sRSMDepth,
                float4( uv, 0.0f, 0.0f ) ).r;

        float valid =
            inside * edge * step( depth, 0.9999f );

        [branch]
        if ( valid > 1.0e-4f )
        {
            float3 toSurface =
                RH_ReconstructRSMPositionVisibility( uv, depth ) -
                cellCenterWS;

            float distanceSquared =
                dot( toSurface, toSurface );

            [branch]
            if ( distanceSquared > 1.0e-5f )
            {
                float inverseDistance =
                    rsqrt( distanceSquared );

                float distanceCells =
                    distanceSquared * inverseDistance / cellSize;

                float occupancy =
                    1.0f -
                    smoothstep(
                        max( g_vecVisibility.y, 0.0f ),
                        outerRadius,
                        distanceCells );

                float3 directionToBlocker =
                    toSurface * inverseDistance;

                float3 surfaceNormal =
                    tex2Dlod(
                        sRSMNormal,
                        float4( uv, 0.0f, 0.0f ) ).xyz *
                    2.0f - 1.0f;

                surfaceNormal =
                    RH_SafeNormalize(
                        surfaceNormal,
                        -directionToBlocker );

                float facing =
                    0.35f +
                    0.65f *
                    abs(
                        dot(
                            surfaceNormal,
                            -directionToBlocker ) );

                facing =
                    lerp(
                        1.0f,
                        facing,
                        normalInfluence );

                occupancy *=
                    exp2(
                        -distanceDecay *
                        distanceCells );

                occupancy *=
                    valid *
                    visibilityEnable *
                    visibilityStrength *
                    facing;

                visibilitySH +=
                    RH_ProjectDirection(
                        directionToBlocker ) *
                    ( occupancy * g_vecPass.x );

                validWeight += valid;
            }
        }
    }

    visibilitySH /= max( validWeight, 1.0f );

    return RH_LimitVisibilitySH( visibilitySH );
}
