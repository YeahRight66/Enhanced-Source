// STATIC: "VISIBILITY_PHASE" "0..1"
// 0 = cardinal D4 samples, 1 = diagonal D4 samples.

#include "common_ps_fxc.h"
#include "radiance_hints_common_fxc.h"

const float4x4 g_matWorldToRSM : register( c0 );
const float4x4 g_matRSMToWorld : register( c4 );
const float3   g_vecGridOrigin : register( c8 );

// x = volume extent, y = cell size, z = edge fade, w = RSM world side
const float4 g_vecRHSettings : register( c9 );
// x = enable, y = inner radius cells, z = outer radius cells, w = strength
const float4 g_vecVisibility : register( c10 );
// x = distance decay, y = inverse RSM resolution,
// z = dilation cells, w = normal-facing influence
const float4 g_vecDecay : register( c11 );
// x = per-view accumulation scale (0.5 for front/back dual capture)
const float4 g_vecPass : register( c12 );

sampler sRSMDepth  : register( s0 );
sampler sRSMNormal : register( s1 );

struct PS_INPUT
{
    float3 vVolumeUVW : TEXCOORD0;
    float2 vAtlasUV   : TEXCOORD1;
};

float3 RH_ReconstructRSMPositionVisibility( float2 uv, float depth )
{
    float4 world = mul( float4( uv, depth, 1.0f ), g_matRSMToWorld );
    return world.xyz / max( abs( world.w ), 1.0e-6f );
}

// Scoped macro rather than a sampler-heavy helper with eleven parameters.
// Each compile permutation expands only four calls, which avoids the internal
// compiler crash seen in the old Source FXC while retaining all eight samples
// after the two additive volume draws.
#define RH_ACCUMULATE_VISIBILITY_SAMPLE( OX, OY ) \
{ \
    float2 rhUV = centerUV + float2( OX, OY ) * sampleUVScale; \
    float rhInside = step( 0.0f, rhUV.x ) * step( rhUV.x, 1.0f ) \
        * step( 0.0f, rhUV.y ) * step( rhUV.y, 1.0f ); \
    rhUV = saturate( rhUV ); \
    float rhEdge = min( min( rhUV.x, rhUV.y ), min( 1.0f - rhUV.x, 1.0f - rhUV.y ) ); \
    rhEdge = saturate( rhEdge / max( g_vecRHSettings.z, 1.0e-4f ) ); \
    rhEdge = rhEdge * rhEdge * ( 3.0f - 2.0f * rhEdge ); \
    float rhDepth = tex2Dlod( sRSMDepth, float4( rhUV, 0.0f, 0.0f ) ).r; \
    float rhValidDepth = rhInside * rhEdge * step( rhDepth, 0.9999f ); \
    float3 rhToSurface = RH_ReconstructRSMPositionVisibility( rhUV, rhDepth ) - cellCenterWS; \
    float rhDistanceSquared = dot( rhToSurface, rhToSurface ); \
    float rhValidDistance = step( 1.0e-5f, rhDistanceSquared ); \
    float rhInverseDistance = rsqrt( max( rhDistanceSquared, 1.0e-5f ) ); \
    float rhDistanceCells = rhDistanceSquared * rhInverseDistance / cellSize; \
    float rhOccupancy = 1.0f - smoothstep( max( g_vecVisibility.y, 0.0f ), outerRadius, rhDistanceCells ); \
    float3 rhDirectionToBlocker = rhToSurface * rhInverseDistance; \
    float3 rhSurfaceNormal = tex2Dlod( sRSMNormal, float4( rhUV, 0.0f, 0.0f ) ).xyz * 2.0f - 1.0f; \
    rhSurfaceNormal = RH_SafeNormalize( rhSurfaceNormal, -rhDirectionToBlocker ); \
    float rhFacing = 0.35f + 0.65f * abs( dot( rhSurfaceNormal, -rhDirectionToBlocker ) ); \
    rhFacing = lerp( 1.0f, rhFacing, normalInfluence ); \
    rhOccupancy *= exp2( -distanceDecay * rhDistanceCells ); \
    rhOccupancy *= rhValidDepth * rhValidDistance * visibilityEnable \
        * visibilityStrength * rhFacing * sampleScale; \
    visibilitySH += RH_ProjectDirection( rhDirectionToBlocker ) * rhOccupancy; \
}

float4 main( const PS_INPUT In ) : COLOR0
{
    float cellSize = max( g_vecRHSettings.y, 1.0f );
    float inverseRSMWorldSide = 1.0f / max( g_vecRHSettings.w, 1.0f );
    float3 cellCenterWS = g_vecGridOrigin + In.vVolumeUVW * g_vecRHSettings.x;
    float4 projected = mul( float4( cellCenterWS, 1.0f ), g_matWorldToRSM );
    float2 centerUV = projected.xy / max( abs( projected.w ), 1.0e-6f );

    float footprintCells = g_vecRHSettings.w * g_vecDecay.y / cellSize;
    float outerRadius = max(
        g_vecVisibility.z + g_vecDecay.z + footprintCells,
        g_vecVisibility.y + 0.01f );
    float sampleUVScale = cellSize * max( outerRadius, 1.0f ) * inverseRSMWorldSide;
    float visibilityEnable = saturate( g_vecVisibility.x );
    float visibilityStrength = max( g_vecVisibility.w, 0.0f );
    float distanceDecay = max( g_vecDecay.x, 0.0f );
    float normalInfluence = saturate( g_vecDecay.w );
    float sampleScale = g_vecPass.x / RH_VISIBILITY_SAMPLE_COUNT;

    float4 visibilitySH = 0.0f;
#if VISIBILITY_PHASE == 0
    RH_ACCUMULATE_VISIBILITY_SAMPLE( 0.34f, 0.00f );
    RH_ACCUMULATE_VISIBILITY_SAMPLE(-0.34f, 0.00f );
    RH_ACCUMULATE_VISIBILITY_SAMPLE( 0.00f, 0.34f );
    RH_ACCUMULATE_VISIBILITY_SAMPLE( 0.00f,-0.34f );
#else
#if RH_VISIBILITY_SAMPLE_COUNT == 8
    RH_ACCUMULATE_VISIBILITY_SAMPLE( 0.58f, 0.58f );
    RH_ACCUMULATE_VISIBILITY_SAMPLE(-0.58f, 0.58f );
    RH_ACCUMULATE_VISIBILITY_SAMPLE( 0.58f,-0.58f );
    RH_ACCUMULATE_VISIBILITY_SAMPLE(-0.58f,-0.58f );
#endif
#endif

    return RH_LimitVisibilitySH( visibilitySH );
}
