#include "common_vs_fxc.h"
#include "common_deferred_fxc.h"

struct VS_INPUT
{
	float3 vPos       : POSITION;
	float3 vVolumeUVW : TANGENT;
	float2 vAtlasUV   : TEXCOORD0;
};

struct VS_OUTPUT
{
	float4 vProjPos   : POSITION;
	float3 vVolumeUVW : TEXCOORD0;
	float2 vAtlasUV   : TEXCOORD1;
};

VS_OUTPUT main( const VS_INPUT In )
{
	VS_OUTPUT Out;
	Out.vProjPos = float4( In.vPos, 1.0f );
	Out.vVolumeUVW = In.vVolumeUVW;
	Out.vAtlasUV = In.vAtlasUV;
	return Out;
}
